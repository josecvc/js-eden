func addSample {
    ${{
        const picker = document.getElementById("audio-file-input");
        picker.onchange = async (e) => {
             // TODO: Find a way to get this to activate when someone defines a sample
            e.preventDefault();
            e.stopPropagation();
            
            // console.log(e.target.files);
            const files = e.target.files;
            const file = files[0];
            
            if(!file) return;

            const buf = await file.arrayBuffer();
            const data = await root.lookup("ctx").value().decodeAudioData(buf);

            // send audio data to engine

            let left = data.getChannelData(0);
            let right;

            if (data.numberOfChannels == 2) {
                right = data.getChannelData(1);
            } else if (data.numberOfChannels == 1) {
                right = left;
            } else {
                throw new Error("Maximum 2 channels per sample.");
            }
            
            const encoder = new TextEncoder();
            root.lookup("engine_node").value().port.postMessage({
               type: "sample",
               id: root.lookup("samplePool").value().length,
               filename: file.name,
               encoded: encoder.encode(file.name),
               channels: data.numberOfChannels,
               sampleRate: data.sampleRate,
               duration: data.length,
               data: [left, right],
            })

            const blockSize = Math.floor(data.length / 1024);
            const wf = new Float32Array(1024);

            const monoform = new Float32Array(data.length);

            for (let i = 0; i < data.length; i++) {
                monoform[i] = (left[i] + right[i]) * 0.5;
            }

            for (let i = 0; i < 1024; i++) {
                let sum = 0;
                const start = i * blockSize;
                const end = Math.min(start + blockSize, data.length);
                
                for (let j = start; j < end; j++) sum += monoform[j];

                wf[i] = sum / (end - start);
            }

            root.lookup("samplePool").value().push(
                {
                    filename: file.name,
                    sampleRate: data.sampleRate,
                    channels: data.numberOfChannels,
                    length: data.length,
                    waveform: wf,
                    leftPtr: 0,
                    rightPtr: 0
                }
            )

            root.lookup("sampleDirty").assign(true, root.scope);
        }

        picker.click();
    }}$
}

func Sample {
    para obsName

    createView("hidden", "HTMLContent");
    view_hidden_title = "Hidden input";
    view_hidden_visibility = "hidden";
    view_hidden_content = "<input type='file' id='audio-file-input' accept='audio/*' title='Upload Sample'>"

    addSample();

    ${{
        let o = obsName ?? null;
        return new Sample(o);
    }}$
}

