"use cs3;"

/**
 * @title Start Your Model
 */

func initAudioContext {
        ${{
            const audio_context = new AudioContext();
            return audio_context;
        }}$;
    }

func initGainNode {
    ${{
        gainNode = root.lookup("ctx").value().createGain();
        gainNode.connect(root.lookup("ctx").value().destination);
        gainNode.gain.value = 1;
        return gainNode;
    }}$;
}

# nodes used to play audio
ctx is initAudioContext();
gain_node is initGainNode();
engine_node is null; # this specifically is for holding the engine

NUM_PATTERNS is 255;
NUM_ROWS is 64;
NUM_CHANNELS is 8;
NUM_ORDERS is 255;

samplePool = [];
playbackArray = null;

${{   
    root.lookup("ctx").value().audioWorklet.addModule("../../klaxon-engine/js/audio-base.js").then(() => {
        console.log(
            root.lookup("ctx").value().sampleRate
        )
        const node = new AudioWorkletNode(root.lookup("ctx").value(), "mixer-processor", {numberOfOutputs: 1, outputChannelCount: [2]});

        node.connect(root.lookup("gain_node").value());
        
        fetch("../../klaxon-engine/build/dsp.wasm").then((res) => {
            if(res.ok) {
                res.arrayBuffer().then((buffer) => {
                node.port.postMessage({
                    type: "wasm",
                    wasm: buffer,
                    sampleRate: root.lookup("ctx").value().sampleRate,
                    bpm: 140,
                    ticksPerRow: 6,
                    numPatterns: 255,
                    numRows: 64,
                    numChannels: 8
                    })
                }).then((res) => {
                    setTimeout(()=>{ root.lookup("wasmReady").assign(true, root.scope)}, 500);
                   
                }).catch((e) => console.log("Error: Failed to post message to AudioWorkerNode\n" + e));
            } else {
                throw new Error(res.status);
            }
            
        }).catch((e) => {console.log("Error: Failed to retrieve WebAssembly module.\n" + e);})

        node.port.onmessage = (e) => {
            const data = e.data;

            if(data.type == "sab") {
                root.lookup("playbackArray").assign(
                    new Int32Array(data.sharedBuffer), root.scope
                );
            }
        };

        root.lookup("engine_node").assign(node, root.scope, Eden.EdenSymbol.defaultAgent);
    }).catch((e) => {
        console.log("Error: Audio Processor failed to initialise.\n" + e);
    });
}}$;

${{
    const keysDown = new Set();
    
    const keyToNote = { // Use your keyboard!
        "KeyZ" : 0, // C 0
        "KeyS": 1,  // C#0
        "KeyX" : 2, // D 0
        "KeyD" : 3, // D#0
        "KeyC": 4,  // E 0
        "KeyV": 5,  // F 0
        "KeyG": 6,  // F#0
        "KeyB": 7,  // G 0
        "KeyH": 8,  // G#0
        "KeyN": 9,  // A 0 
        "KeyJ": 10, // A#0
        "KeyM": 11, // B 0
        "Comma": 12,     "KeyQ" : 12, // C 1
        "KeyL": 13,      "Digit2" : 13, // C#1
        "Period": 14,    "KeyW" :   14,//D 1
        "Semicolon": 15, "Digit3" : 15, // D#1
        "KeyE" :   16, // E 1
        "KeyR" :   17, // F 1
        "Digit5" : 18, // F#1
        "KeyT" :   19, // G 1
        "Digit6" : 20, // G#1
        "KeyY" :   21, // A 1
        "Digit7" : 22, // A#1
        "KeyU" :   23, // B 1
        "KeyI" :   24, // C 2
        "Digit9" : 25, // C#2
        "KeyO" :   26, // D 2
        "Digit0" : 27, // D#2
        "KeyP" :   28  // E 2
    };


    addEventListener("keydown", (e) => {    
        const code = e.code;
        if(!keyToNote.hasOwnProperty(code)) return;

        const element = document.activeElement;
        
        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        if(root.lookup("is_playing").value()) return;

        if (e.shiftKey || e.ctrlKey) return;

        const octave = root.lookup("octave").value();

        const midiKey = keyToNote[code] + (octave + 1) * 12;

        const gridFocus = root.lookup("gridFocus");
        if(!keysDown.has(code)) {
            keysDown.add(code);
            root.lookup("engine_node").value().port.postMessage({
                type: "note_on",
                note: midiKey,
                instrumentId: root.lookup("current_instrument").value()
            })
        }

        // keyboard assignment for note
        
        const currentElement = root.lookup("currentElement");

        if(gridFocus.value() && currentElement.value() == 0) {
            if(!keysDown.has(code)) return;

            root.lookup("elementValue").assign(midiKey, root.scope);
            root.lookup("elementDirty").assign(true, root.scope);
        }

    })

    addEventListener("keydown", (e) => {
        const code = e.code;

        const element = document.activeElement;
        
        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        if(root.lookup("is_playing").value()) return;

        if (e.shiftKey || e.ctrlKey) return;

        const gridFocus = root.lookup("gridFocus");
        const currentElement = root.lookup("currentElement");

        if(gridFocus.value() && currentElement.value() != 0) {
            if(!code.startsWith("Digit")) return;

            const val = Number(code.slice(5));

            root.lookup("elementValue").assign(val, root.scope);
            root.lookup("elementDirty").assign(true, root.scope);
        }
    })

    addEventListener("keyup", (e) => {
        const code = e.code;

        const element = document.activeElement;

        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        if(root.lookup("is_playing").value()) return;

        if (e.shiftKey || e.ctrlKey) return;

        const octave = root.lookup("octave").value();
        const gridFocus = root.lookup("gridFocus");

        if(keyToNote.hasOwnProperty(code)) {
            keysDown.delete(code);

            if(gridFocus.value()) { // this is so we dont have to hear the audio play fully when adding data to the grid
                root.lookup("engine_node").value().port.postMessage({
                type: "note_off",
                note: keyToNote[code] + (octave + 1) * 12,
                instrumentId: root.lookup("current_instrument").value()
            })
            }
        }
    })

    addEventListener("keydown", (e) => {
        const element = document.activeElement;

        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        const code = e.code;

        
        if(code == "Space") {
            e.preventDefault(); // don't scroll down
            const isFocused = root.lookup("gridFocus").value();
            if(!isFocused) {
                root.lookup("gridFocus").assign(true, root.scope);
            } else {
                root.lookup("gridFocus").assign(false, root.scope);
            }
        }
    })

    addEventListener("keydown", (e) => {
        const element = document.activeElement;

        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        const code = e.code;

        if (e.shiftKey && e.ctrlKey) {
            if (code.startsWith("Digit")) {
                const octave = Number(code.slice(5)) - 1; // octave 0 - 7 (from bottom set of keys)

                if (octave < 0 || octave > 7) return; // 0 and 9 not allowed;

                root.lookup("octave").assign(octave, root.scope);
            }
        }
    })

    addEventListener("keydown", (e) => {
        const element = document.activeElement;

        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        const code = e.code;

        const isFocused = root.lookup("gridFocus").value();
        if (element.tagName.toLowerCase() == "canvas" && (code == "ArrowUp" || code == "ArrowDown" || code == "ArrowLeft" || code == "ArrowRight")) {
            e.preventDefault();
        }

        if (!isFocused) return;

        console.log("You pressed " + code);
        if (code == "ArrowUp") {
            const rowFocus = root.lookup("keyboardRowFocus");
            const currentPattern = root.lookup("currentPattern");
            const currentPatternRows = root.lookup("patternRows").value()[currentPattern.value() - 1];

            if (rowFocus.value() == 0) return;
            
            rowFocus.assign(rowFocus.value() - 1, root.scope);
        } else if (code == "ArrowDown") {
            const rowFocus = root.lookup("keyboardRowFocus");
            const currentPattern = root.lookup("currentPattern");
            const currentPatternRows = root.lookup("patternRows").value()[currentPattern.value() - 1];

            if (rowFocus.value() >= currentPatternRows - 1) return;

            rowFocus.assign(rowFocus.value() + 1, root.scope);
        } else if (code == "ArrowLeft") {
            const channelFocus = root.lookup("keyboardChannelFocus");
            const elementFocus = root.lookup("keyboardElementFocus");
            const numElements = 5;
            const numChannels = root.lookup("numChannels");

            if (channelFocus.value() <= 0 && elementFocus.value() <= 0) return;
            
            if(elementFocus.value() - 1 < 0) {
                elementFocus.assign(numElements - 1, root.scope);
                channelFocus.assign(channelFocus.value() - 1, root.scope);
            } else {
                elementFocus.assign(elementFocus.value() - 1, root.scope);
            }
        } else if (code == "ArrowRight") {
            const channelFocus = root.lookup("keyboardChannelFocus");
            const elementFocus = root.lookup("keyboardElementFocus");
            const numElements = 5;
            const numChannels = root.lookup("numChannels");

            if (channelFocus.value() >= (numChannels.value() - 1) && elementFocus.value() >= (numElements - 1)) return;
            
            if(elementFocus.value() + 1 == numElements) {
                elementFocus.assign(0, root.scope);
                channelFocus.assign(channelFocus.value() + 1, root.scope);
            } else {
                elementFocus.assign(elementFocus.value() + 1, root.scope);
            }
        }
    })
}}$;

${{
    function updatePlayback() {
        const playing = root.lookup("is_playing");
        const playbackArray = root.lookup("playbackArray");

        const ROW = 0;
        const PATTERN = 1;
        const ORDER = 2;
        const IS_PLAYING = 3;

        if (playing.value()) {
            const row = Atomics.load(playbackArray.value(), ROW);
            const pattern = Atomics.load(playbackArray.value(), PATTERN);
            const order = Atomics.load(playbackArray.value(), ORDER);
            // const playbackState = Atomics.load(playbackArray.value(), IS_PLAYING);

            root.lookup("currentRow").assign(row, root.scope);
            root.lookup("currentPattern").assign(pattern + 1, root.scope);
            root.lookup("currentOrder").assign(order, root.scope);

            // TODO: Make another SharedArrayBuffer to directly modify playback state from JS-EDEN (without the need for postMessage)
            // root.lookup("is_playing").assign(Boolean(playbackState), root.scope); 
        }

        requestAnimationFrame(updatePlayback);
    }

    requestAnimationFrame(updatePlayback);
}}$

