## ROW/CHANNEL COUNT

action InsertOrder {
    if(currentOrder >= 0 && currentOrder < MAX_ORDER) {
        if (patternOrder[currentOrder + 1 + 1] != 255) {
            for(i = numOrders; i > currentOrder; i--) {
                patternOrder[i] = patternOrder[i - 1];
            }
        }

        patternOrder[currentOrder + 1] = currentPattern - 1;
        numOrders++;
    }
}

action DeleteOrder {
    if(currentOrder >= 0 && currentOrder < MAX_ORDER) {
        for (i = position; i < numOrders; i++)
        {  
            patternOrder[i] = patternOrder[i + 1];
        }

        patternOrder[numOrders] = 255;
        numOrders--;
    }
}

action ResizeChannels {
    ${{
        // Can be Eden code but hangs the environment whenever I try

        const upDown = root.lookup("upDown").value();
        const oldCount = root.lookup("numChannels").value();
        const newCount = upDown ? (oldCount + 2) : (oldCount - 2);
        const MAX_CHANNELS = root.lookup("MAX_CHANNELS").value();
        
        if(newCount <= MAX_CHANNELS && newCount >= 2) {
            const MAX_PATTERNS = root.lookup("MAX_PATTERNS").value();
            const patternArray = root.lookup("patternArray").value();
            const patternRows = root.lookup("patternRows").value();

            const channelRide = Math.min(oldCount, newCount);
            const empty = [0, 0, 0, 0, 0];

            for(let p = 0; p < MAX_PATTERNS; p++) {
                patternArray[p] = patternArray[p].map(row => {
                    if (upDown) {
                        return [...row, empty, empty];
                    } else {
                        return row.slice(0, newCount);
                    }
                });
            }

            root.lookup("numChannels").assign(newCount, root.scope);
        }
    }}$
}

action ResizeRow {
    tempPattern = patternArray[currentPattern];

    oldCount = patternRows[currentPattern];
    newCount = (oldCount + 1) if upDown else (oldCount - 1);

    if(newCount > 0 && newCount <= MAX_ROWS) {
        rowRide = min(oldCount, newCount);

        newChannelCells = oneCell with ch is 1..numChannels;
        newRowCells = newChannelCells with r is 1..newCount;

        for(r = 1; r < rowRide + 1; r++) {
            newRowCells[r][ch] = tempPattern[r][ch];
        }

        patternArray[currentPattern] = newRowCells;
        patternRows[currentPattern] = newCount;
    }
}

action ExpandPattern {
    tempPattern = patternArray[currentPattern ];

    oldCount = patternRows[currentPattern];
    newCount = patternRows[currentPattern] * 2;

    if (newCount <= MAX_ROWS) {
        newChannelCells = oneCell with ch is 1..numChannels;
        newRowCells = newChannelCells with r is 1..newCount;

        for(r = 1; r < oldCount + 1; r++) {
            newRowCells[(r - 1) * 2 + 1] = tempPattern[r];
        }

        patternArray[currentPattern] = newRowCells;
        patternRows[currentPattern] = newCount;
    }
}

action ShrinkPattern {
    tempPattern = patternArray[currentPattern];

    oldCount = patternRows[currentPattern];
    newCount = floor(patternRows[currentPattern] / 2);

    if (newCount >= 1) {

        newChannelCells = oneCell with ch is 1..numChannels;
        newRowCells = newChannelCells with r is 1..newCount;

        for(r = 1; r < oldCount + 1; r+=2) {
            newRowCells[(r - 1) / 2 + 1] = tempPattern[r];
        }

        patternArray[currentPattern] = newRowCells;
        patternRows[currentPattern] = newCount;
    }
}

## ACTIONS

action MakeUI {
# Set up canvas
createCanvas("PatternEditor", "editorCanvas", "Klaxon Tracker");
patternFocus is patternArray[currentPattern];

mouseWheelEnabled = true;
touchPinchEnabled = true;

view_PatternEditor_width = 1193;
view_PatternEditor_height = 843;

viewportWidth is view_PatternEditor_width;
viewportHeight is view_PatternEditor_height;

view_PatternEditor_x = 295.5;
view_PatternEditor_y = 8.5;

scale = 0.75;
fontSize is 30 * scale;
buttonSize is 30 * scale;

# Cell Size
cellWidth is viewportWidth/6 * scale;
cellHeight is viewportHeight/24 * scale;

gridOffset  is [40 - scrollHorz, viewportHeight/1.7 - (currentRow)*cellHeight]
orderOffset is [viewportWidth/75, viewportHeight/16 -(currentOrder+1)*fontSize + cellHeight/2]
instrOffset is [1, fontSize -(instrScroll)*fontSize];
sampleOffset is [1, fontSize - (sampleScroll)*fontSize];

# Covers
topCover is Rectangle(0, 0, viewportWidth, viewportHeight/4, "#625353", "#000000"); # add gradient afterwards
bottomCover is Rectangle(0, viewportHeight/4, viewportWidth, 3*viewportHeight/4 - viewportHeight/28, "#74747400", "#000000");
channelRect is Rectangle(ch*cellWidth + gridOffset[1], viewportHeight/4 , cellWidth, 3*viewportHeight/4, "#00000000", "#000000") with ch is 0..(numChannels - 1);
rowNoStrip is Rectangle(0, viewportHeight/4, 40, 3*viewportHeight/4, "white", "black");

instrumentsBg is Rectangle(viewportWidth/2, 0, viewportWidth/4, viewportHeight/4, "#784545", "#000000");
samplesBg is Rectangle(3*viewportWidth/4, 0, viewportWidth/4, viewportHeight/4, "#784545", "#000000");

orderBackground is Rectangle(0, 0, viewportWidth/12, viewportHeight/8, "#784545", "#000000");
orderSeqSep is Rectangle(0, 0, viewportWidth/24, viewportHeight/8, "#00000000", "#000000");
orderPatSep is Rectangle(viewportWidth/24, 0, viewportWidth/24, viewportHeight/8, "#00000000", "#000000");

instrSep is Rectangle(viewportWidth/2, 0, viewportWidth/4, viewportHeight/4, "#00000000", "#000000");
sampSep is Rectangle(3*viewportWidth/4, 0, viewportWidth/4, viewportHeight/4, "#00000000", "#000000");

# Buttons
playButton is Button("playbtn", "Play", 0, viewportHeight/8 + buttonSize, buttonSize * 4, buttonSize * 1.5);
stopButton is Button("stopbtn", "Stop", 0, viewportHeight/8 + buttonSize + buttonSize * 1.5, buttonSize * 4, buttonSize * 1.5);

tempoPlusButton is Button("tempoplus",   "+", viewportWidth/4.5, viewportHeight/15      , buttonSize, buttonSize);
tempoMinusButton is Button("tempominus", "-", viewportWidth/4.5 + buttonSize, viewportHeight/15, buttonSize, buttonSize);

speedPlusButton is Button("speedplus", "+", viewportWidth/4.5, viewportHeight/15 + buttonSize, buttonSize, buttonSize);
speedMinusButton is Button("speedminus", "-", viewportWidth/4.5 + buttonSize, viewportHeight/15 + buttonSize, buttonSize, buttonSize);

patternPlusButton is Button("patternplus", "+", viewportWidth/2.75, viewportHeight/15, buttonSize, buttonSize);
patternMinusButton is Button("patternminus", "-", viewportWidth/2.75 + buttonSize, viewportHeight/15, buttonSize, buttonSize);

octavePlusButton is Button("octaveplus", "+", viewportWidth/2.75, viewportHeight/15 + buttonSize, buttonSize, buttonSize);
octaveMinusButton is Button("octaveminus", "-", viewportWidth/2.75 + buttonSize, viewportHeight/15 + buttonSize, buttonSize, buttonSize);

orderInsertButton is Button("orderinsert", "Ins.", 0, viewportHeight/8, buttonSize*2, buttonSize);
orderDelButton is Button("orderdelete", "Del.", buttonSize*2, viewportHeight/8, buttonSize*2, buttonSize);

sampleLoadButton is Button("sampleload", "Load", 3*viewportWidth/4 + fontSize*4, 0, buttonSize*2, buttonSize);
sampleClearButton is Button("sampleclear", "Clear", 3*viewportWidth/4 + buttonSize*2 + fontSize*4, 0, buttonSize*2, buttonSize);

stepPlusButton is Button("stepplus", "+", buttonSize*4*4 + 50 + fontSize*4, viewportHeight/8 + buttonSize*1.25, buttonSize, buttonSize);
stepMinusButton is Button("stepminus", "-", buttonSize*4*4 + 50 + fontSize*4 + buttonSize, viewportHeight/8 + buttonSize*1.25, buttonSize, buttonSize);

# PATTERN MUTATION BUTTONS
expandButton is Button("expandpat", "Expand", buttonSize*4*2, viewportHeight/8 + buttonSize, buttonSize*4, buttonSize * 1.5);
shrinkButton is Button("shrinkpat", "Shrink", buttonSize*4*2, viewportHeight/8 + buttonSize + buttonSize * 1.5, buttonSize * 4, buttonSize * 1.5);

addChanButton is Button("addchan", "Add Chan.", buttonSize*4*3, viewportHeight/8 + buttonSize, buttonSize*4, buttonSize * 1.5);
subChanButton is Button("subchan", "Sub Chan.", buttonSize*4*3, viewportHeight/8 + buttonSize + buttonSize * 1.5, buttonSize * 4, buttonSize * 1.5);

lenPlusButton is Button("lenplus", "+", buttonSize*4*4 + 50 + fontSize*4, viewportHeight/8 + buttonSize*1.25 + buttonSize, buttonSize, buttonSize);
lenMinusButton is Button("lenminus", "-", buttonSize*4*4 + 50 + fontSize*4 + buttonSize, viewportHeight/8 + buttonSize*1.25 + buttonSize, buttonSize, buttonSize);

# ORDER MUTATION BUTTONS

orderPlusButton is Button("orderplus", "+", viewportWidth/12, 0, buttonSize, buttonSize);
orderMinusButton is Button("orderminus", "-", viewportWidth/12 + buttonSize, 0, buttonSize, buttonSize);

orderUpButton is Button("orderup", "U", viewportWidth/12, buttonSize, buttonSize, buttonSize);
orderDownButton is Button("orderdown", "D", viewportWidth/12 + buttonSize, buttonSize, buttonSize, buttonSize);

sampleEditButton is Button("sampleedit", "Smp Edit", buttonSize*4, viewportHeight/8 + buttonSize, buttonSize*4, buttonSize * 1.5);

instrumentEditButton is Button("instrumentedit", "Instr Edit", buttonSize*4, viewportHeight/8 + buttonSize + buttonSize * 1.5, buttonSize * 4, buttonSize * 1.5);

buttons is [playButton, stopButton, tempoPlusButton, tempoMinusButton, 
    speedPlusButton, speedMinusButton, patternPlusButton, patternMinusButton, 
    orderInsertButton, orderDelButton, sampleLoadButton, sampleClearButton,
    sampleEditButton, instrumentEditButton, octavePlusButton, octaveMinusButton,
    expandButton, shrinkButton, addChanButton, subChanButton,
    stepPlusButton, stepMinusButton, lenPlusButton, lenMinusButton,
    orderPlusButton, orderMinusButton, orderUpButton, orderDownButton
];

# Div("<h1></h1>", 0, 0, 1, 1, "font: serif");

# Information
titleText is Text("KlaxonTracker", 3 * viewportWidth/16, 0, fontSize * 2, "white", "bold", Object("css_class_list", "klaxon-heading"));
instrIndicator is Text("Instruments", viewportWidth/2, 0, fontSize, "white");
sampleIndicator is Text("Samples", 3*viewportWidth/4, 0, fontSize, "white");

tempoText is Text("BPM  " + bpm, viewportWidth/8, viewportHeight/14, fontSize, "white", "#CBE5D4");
speedText is Text("SPD  " + ticksPerRow, viewportWidth/8, viewportHeight/14 + fontSize, fontSize, "white", "#CBE5D4");
patternIDTxt is Text("Pattern: " + (currentPattern - 1), viewportWidth/4 + buttonSize, viewportHeight/14, fontSize, "white", "#CBE5D4");

octaveText is Text("Octave: " + octave, viewportWidth/4 + buttonSize, viewportHeight/14 + fontSize, fontSize, "white", "#CBE5D4");

stepText is Text("Step: " + step, buttonSize*4*4 + 30, viewportHeight/8 + buttonSize + 10, fontSize, "white", "#CBE5D4");
lengthText is Text("Rows: " + patternRows[currentPattern], buttonSize*4*4 + 30, viewportHeight/8 + buttonSize + 10 + fontSize, fontSize, "white", "#CBE5D4");

information is [titleText, tempoText, speedText, patternIDTxt, octaveText, instrIndicator, sampleIndicator, stepText, lengthText];

# Order Rendering
seqClassifier is "0" + s if(s < 10) else s;
patClassifier is "0" + patternOrder[s+1] if (patternOrder[s+1] < 10) else patternOrder[s+1];

orderCell is Rectangle(0, viewportHeight/16 - cellHeight/2, 2*cellWidth/3, cellHeight, "#c95757");

seqNum  is Text(seqClassifier, 0 + orderOffset[1], s*fontSize + orderOffset[2], fontSize, "black" if s == currentOrder else "white") with s is 0..(numOrders - 1);
patNum is Text(patClassifier, viewportWidth/28 + orderOffset[1], s*fontSize + orderOffset[2], fontSize, "black" if s == currentOrder else "white") with s is 0..(numOrders - 1);

orderRender is [orderBackground, orderCell, seqNum, patNum, orderPatSep, orderSeqSep];

# Instrument List Rendering

# name, x, y, width, height, placeholder, maxlength, enabled
# instrName is Textbox("instrument_" + s, 0, 0, 100, 100, "", 200, true, Object("background-color", "transparent")) with s is 1;

instrNum is Text(s if ((s - 1)*fontSize + instrOffset[2] + fontSize < viewportHeight/4) else "", viewportWidth/2 + instrOffset[1], (s - 1)*fontSize + instrOffset[2], fontSize, "black" if s == currentInstrument else "white") with s is 1..128;

# Instrument List Scrolling 

instrumentScrollView is Rectangle(3*viewportWidth/4 - viewportHeight/28, 0, viewportHeight/28, viewportHeight/4, "#625353", "#ffffff");

topIScroll is Rectangle(3*viewportWidth/4 - viewportHeight/28, 0, viewportHeight/28, viewportHeight/28, "#000000");
btmIScroll is Rectangle(3*viewportWidth/4 - viewportHeight/28, viewportHeight/4 - viewportHeight/28, viewportHeight/28, viewportHeight/28, "#000000");

instrumentScrollBar is Rectangle(3*viewportWidth/4 - viewportHeight/28, viewportHeight/28 + 
    (instrScroll * fontSize)/(viewportHeight/4) * ((viewportHeight/4) / fontSize),  viewportHeight/28, (viewportWidth/4)/(128 * fontSize) * (viewportWidth/4 - 2*viewportHeight/28),"#c98585", "#000000");

instrumentScrollPort is [instrumentScrollView, topIScroll, btmIScroll, instrumentScrollBar];

instrListRender is [instrumentsBg, instrNum, instrSep, instrName, instrumentScrollPort];

# Sample List Rendering
sampleNum is Text(s if (s*fontSize + sampleOffset[2] + fontSize < viewportHeight/4) else "", 3 * viewportWidth/4 + sampleOffset[1], s*fontSize + sampleOffset[2], fontSize, "black" if s == currentSample else "white") with s is 0..15;

sampleName is samplePool[s+1].filename if (s+1 <= samplePool.length) else "";

sampleText is Text(sampleName if (s*fontSize + sampleOffset[2] < viewportHeight/4) else "", 3 * viewportWidth/4 + fontSize + sampleOffset[1], s*fontSize + sampleOffset[2], fontSize, "black" if s == currentSample else "white") with s is 0..15;


# Sample List Scrolling

sampleScrollView is Rectangle(viewportWidth - viewportHeight/28, 0, viewportHeight/28, viewportHeight/4, "#625353", "#ffffff");

topSScroll is Rectangle(viewportWidth - viewportHeight/28, 0, viewportHeight/28, viewportHeight/28, "#000000");
btmSScroll is Rectangle(viewportWidth - viewportHeight/28, viewportHeight/4 - viewportHeight/28, viewportHeight/28, viewportHeight/28, "#000000");

sampleScrollBar is Rectangle(viewportWidth - viewportHeight/28, viewportHeight/28 + 
    (sampleScroll * fontSize)/(viewportHeight/4) * ((viewportHeight/4) / fontSize),  viewportHeight/28, (viewportHeight/4)/(16 * fontSize) * (viewportWidth/4 - 2*viewportHeight/28),"#c98585", "#000000");

sampleScrollPort is [sampleScrollView, topSScroll, btmSScroll, sampleScrollBar];

sampleListRender is [samplesBg, sampleNum, sampleText, sampleSep, sampleScrollPort]

editorFocus is grid;

# In render order
editorCanvas is [bottomCover, editorFocus, topCover, orderRender, instrListRender, sampleListRender, information, buttons];
}

action MakeGrid {
# Grid Rendering
channelIDTxt is Text(ch+1, ch * cellWidth + gridOffset[1], viewportHeight/4 + 5, 30, "black", "bold") with ch is 0..(numChannels - 1);
rowNos is Text(r if r > 9 else "0" + r, 0*cellWidth, r*cellHeight + gridOffset[2], cellHeight, "black") with r is 0..(patternRows[currentPattern] - 1)
gridCell is Rectangle(x*cellWidth + gridOffset[1], y*cellHeight + gridOffset[2], cellWidth, cellHeight, "#c7dbb0" if (y == currentRow) else "gray" if (y % 4 == 0) else "#dfdfdf", "#000000");

# Cell Mutation

noteString is semitones[(patternFocus[r+1][ch+1][1] % 12) + 1] + (floor(patternFocus[r+1][ch+1][1] / 12) - 1);

noteClassifier is noteString if (patternFocus[r+1][ch+1][1] >= 12 && patternFocus[r+1][ch+1][1] <= 119) else "---";
instrClassifier is patternFocus[r+1][ch+1][2] if (patternFocus[r+1][ch+1][2] >= 1 && patternFocus[r+1][ch+1][2] <= 255) else "--";
volClassifier is patternFocus[r+1][ch+1][3] if (patternFocus[r+1][ch+1][3] >= 1 && patternFocus[r+1][ch+1][3] <= 100) else "--";
effectClassifier is int2char(patternFocus[r+1][ch+1][4]) if (patternFocus[r+1][ch+1][4] >= 1 && patternFocus[r+1][ch+1][4] <= 26) else "-";
paramClassifier is int2hex(patternFocus[r+1][ch+1][5]) if (patternFocus[r+1][ch+1][5] >= 1 && patternFocus[r+1][ch+1][5] <= 255) else "--";

# Cell Text
noteText   is Text(noteClassifier            , ch*cellWidth + gridOffset[1] + cellWidth/30             , r*cellHeight + gridOffset[2], 22 *  scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 0 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);
instrText  is Text(instrClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 + cellWidth/15 , r*cellHeight + gridOffset[2], 22 * scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 1 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);
volText    is Text(volClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 2  + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 2 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);
effectText is Text(effectClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 3  + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 3 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);
paramText is Text(paramClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 4 + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 4 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);

# KEYBOARD FOCUS
cellFocus is Rectangle(keyboardChannelFocus*cellWidth + keyboardElementFocus*cellWidth/5 +  gridOffset[1], gridOffset[2] +  keyboardRowFocus * cellHeight, cellWidth / 5, cellHeight, "#00000000" if (!gridFocus) else "rgb(0, 0, 0)");

gridBase is gridCell with x is 0..(numChannels - 1), y is 0..(patternRows[currentPattern] - 1);

# GRID SCROLLING
scrollView is Rectangle(0, viewportHeight - viewportHeight/14, viewportWidth, viewportHeight/28, "#625353", "#7f7f7f");

leftHorzScroll is Rectangle(0, viewportHeight - viewportHeight/14, viewportHeight/28, viewportHeight/28, "#000000");
rightHorzScroll is Rectangle(viewportWidth - viewportHeight/28, viewportHeight - viewportHeight/14, viewportHeight/28, viewportHeight/28, "#000000");

scrollBar is Rectangle(viewportHeight/28 + 
    (currentElement/5 * cellWidth + currentChannel * cellWidth)/(viewportWidth) * (viewportWidth/cellWidth * 5) , viewportHeight - viewportHeight/14, viewportWidth/(numChannels*cellWidth + 40) * (viewportWidth - 2*viewportHeight/28), viewportHeight/28,"#c98585", "#000000");

gridHorzScroll is [scrollView, scrollBar, leftHorzScroll, rightHorzScroll];

grid is [gridBase, cellFocus, noteText, instrText, volText, effectText, paramText, channelIDTxt, channelRect,  rowNoStrip, rowNos, gridHorzScroll];
}

action MakeSampleEditor {
sampleBackground is Rectangle(0, viewportHeight/4, viewportWidth, 3*viewportHeight/4, "#424242");
waveformBackground is Rectangle(0, viewportHeight/4 + 40, viewportWidth, 3*viewportHeight/4 / 1.5, "#000000");

# WAVEFORM
waveformMid is Line(0, viewportHeight/4 + 40 + 3*viewportHeight/4 / 1.5 / 2, viewportWidth, viewportHeight/4 + 40 + 3*viewportHeight/4 / 1.5 / 2, "#ffffff9f")
samplePoints is Point((s * viewportWidth) / 1024, samplePool[currentSample + 1].waveform[s + 1] * 3*viewportHeight/4/1.5/2 + viewportHeight/4 + 40 + 3*viewportHeight/4 / 1.5 / 2) with s is 0..1023;
waveform is LineSequence(samplePoints, "#ff7a7a");

# Line(x1, y1, x2, y2)
playheadPosition is samplePlayheads[s + 1]/samplePool[currentSample + 1].length * viewportWidth;
playheads is Line(playheadPosition, viewportHeight/4 + 40, playheadPosition, viewportHeight/4 + 40 + 3*viewportHeight/4 / 1.5, "#cfcfcf") with s is 0..(numSamplePlayheads - 1);

# SAMPLE INFORMATION

lengthTxt is round(samplePool[currentSample + 1].length / sampleRate, 3);
loopStartTxt is round(samplePool[currentSample + 1].loopFrom/sampleRate, 3);
loopLenTxt is round((samplePool[currentSample + 1].loopTo - samplePool[currentSample + 1].loopFrom)/sampleRate, 3);

sampleLength is Text("Length: " + lengthTxt + "s", 7/8 * viewportWidth, 8/10 * viewportHeight, fontSize, "#ffffff");
# sampleLoopType is Text("Loop: " + samplePool[currentSample + 1].loopType, 7/8 * viewportWidth, 8/10*viewportHeight + fontSize, fontSize, "#ffffff");
sampleLoopStart is Text("Start: " + loopStartTxt + "s" , 7/8 * viewportWidth, 8/10*viewportHeight + fontSize, fontSize, "#ffffff");
sampleLoopLen is Text("Length: " + loopLenTxt + "s", 7/8 * viewportWidth, 8/10*viewportHeight + fontSize * 2, fontSize, "#ffffff");

sampleInformation is [sampleLength, sampleLoopType, sampleLoopStart, sampleLoopLen];

# SAMPLE BUTTONS

samplePlayButton is Button("sampleplay", "Play", 0,  8/10 * viewportHeight, buttonSize*4, buttonSize*2.8);
sampleStopButton is Button("samplestop", "Stop", 0, 8/10 * viewportHeight + buttonSize*2.8, buttonSize * 4, buttonSize*2.8);

sampleLoadDedicatedButton is Button("loadinsampleview", "Load", buttonSize * 4, 8/10 * viewportHeight, buttonSize*4, buttonSize*2.8);
sampleClearDedicatedButton is Button("clearinsampleview", "Clear", buttonSize * 4, 8/10 * viewportHeight + buttonSize*2.8, buttonSize*4, buttonSize*2.8);

sampleCopyButton is Button("samplecopy", "Copy", 2*viewportWidth/12, 8/10 * viewportHeight, buttonSize*4, buttonSize*2.8);
sampleCutButton is Button("samplecut", "Cut", 2*viewportWidth/12, 8/10 * viewportHeight + buttonSize*2.8, buttonSize*4, buttonSize*2.8);
samplePasteButton is Button("samplepaste", "Paste", 2*viewportWidth/12 + buttonSize*4, 8/10 * viewportHeight, buttonSize*4, buttonSize*2.8);
sampleCropButton is Button("samplecrop", "Crop", 2*viewportWidth/12 + buttonSize*4, 8/10 * viewportHeight + buttonSize*2.8, buttonSize*4, buttonSize*2.8);

sampleReverseButton is Button("samplereverse", "Reverse", 4*viewportWidth/12, 8/10 * viewportHeight, buttonSize*4, buttonSize*2.8);
sampleNormaliseButton is Button("samplenormalise", "Normalise", 4*viewportWidth/12, 8/10 * viewportHeight + buttonSize*2.8, buttonSize*4, buttonSize*2.8);

sampleUndoButton is Button("sampleundo", "Undo", 5*viewportWidth/12 + buttonSize/2.8, 8/10 * viewportHeight, buttonSize*4, buttonSize*2.8);
sampleRedoButton is Button("sampleredo", "Redo", 5*viewportWidth/12 + buttonSize/2.8, 8/10 * viewportHeight + buttonSize*2.8, buttonSize*4, buttonSize*2.8);

loopSelect is "O" if (samplePool[currentSample + 1].loopType == t) else "X";

loopNoneButton is Button("sampleloopnone", loopSelect, 7*viewportWidth/12 + buttonSize/2.8, 8/10 * viewportHeight, buttonSize/8, buttonSize/8) with t is 0;
loopForwardButton is Button("sampleloopforward", loopSelect, 7*viewportWidth/12 + buttonSize/2.8, 8/10 * viewportHeight + buttonSize, buttonSize/8, buttonSize/8) with t is 1;
loopBidiButton is Button("sampleloopbidi", loopSelect, 7*viewportWidth/12 + buttonSize/2.8, 8/10 * viewportHeight + buttonSize * 2, buttonSize/8, buttonSize/8) with t is 2;

sampleViewButtons is [
    samplePlayButton, sampleStopButton, sampleLoadDedicatedButton, sampleClearDedicatedButton,
    sampleCopyButton, sampleCutButton, samplePasteButton, sampleCropButton,
    sampleReverseButton, sampleNormaliseButton, sampleUndoButton, sampleRedoButton,
    loopNoneButton, loopForwardButton, loopBidiButton
];

# SAMPLE LOOP DETAILS

loopStartX is samplePool[currentSample + 1].loopFrom/samplePool[currentSample + 1].length * viewportWidth;
loopEndX is samplePool[currentSample + 1].loopTo/samplePool[currentSample + 1].length * viewportWidth;

loopStartLine is Line(loopStartX, viewportHeight/4 + 40, loopStartX, viewportHeight/4 + 40 + 3*viewportHeight/4 / 1.5, "#6b6b6b");
loopEndLine is Line(loopEndX, viewportHeight/4 + 40, loopEndX, viewportHeight/4 + 40 + 3*viewportHeight/4 / 1.5, "#6b6b6b");

loopTriY = 3*viewportHeight/4 / 1.5 + viewportHeight/4 + 40;

# use these triangles to query mouse click 
loopStartHead is Polygon([Point(loopStartX, viewportHeight/4 + 40),
    Point(loopStartX + 30, viewportHeight/4 + 40),
    Point(loopStartX, viewportHeight/4 + 40 + 30)], "#b01f1f");
loopEndHead is Polygon([Point(loopEndX, loopTriY),
    Point(loopEndX - 30, loopTriY),
    Point(loopEndX, loopTriY - 30)], "#b01f1f");

loopLines is [loopStartLine, loopEndLine, loopStartHead, loopEndHead] if (samplePool[currentSample + 1].loopType != 0) else [];

loopNoneText is Text("No Loop", 7*viewportWidth/12 + buttonSize*2, 8/10 * viewportHeight, fontSize, "#ffffff");
loopForwardText is Text("Forward", 7*viewportWidth/12 + buttonSize*2, 8/10 * viewportHeight + fontSize, fontSize, "#ffffff");
loopBidiText is Text("Bidi", 7*viewportWidth/12 + buttonSize*2, 8/10 * viewportHeight + fontSize*2, fontSize, "#ffffff");

loopTexts is [loopNoneText, loopForwardText, loopBidiText];

# SAMPLE SELECTION

sampleSelection is Rectangle(selectFrom, viewportHeight/4 + 40, selectTo - selectFrom, 3*viewportHeight/4 / 1.5, "#d0d0d094") if (selectFrom > selectTo || selectTo > selectFrom) else Line(selectFrom, viewportHeight/4 + 40, selectTo, viewportHeight/4 + 40 + 3*viewportHeight/4 / 1.5, "#feffeaa1");

sampleEditor is [sampleBackground, waveformBackground, waveformMid, waveform, playheads, sampleSelection, loopLines, sampleViewButtons, loopTexts, sampleInformation];
}

action MakeInstrumentEditor {

keyScrollHorz = 0;
pianoScrollView is Rectangle(0, viewportHeight - viewportHeight/14, viewportWidth, viewportHeight/28, "#625353", "#7f7f7f");

leftPianoScroll is Rectangle(0, viewportHeight - viewportHeight/14, viewportHeight/28, viewportHeight/28, "#000000");
rightPianoScroll is Rectangle(viewportWidth - viewportHeight/28, viewportHeight - viewportHeight/14, viewportHeight/28, viewportHeight/28, "#000000");

pianoScrollBar is Rectangle(viewportHeight/28 + keyScrollHorz, viewportHeight - viewportHeight/14, viewportWidth/(keyWidth * 7 * numOctaves) * (viewportWidth - 2*viewportHeight/28), viewportHeight/28,"#c98585", "#000000");

pianoScroll is [pianoScrollView, pianoScrollBar, leftPianoScroll, rightPianoScroll];


keyOffset is [-keyScrollHorz, 0];

instrumentBackground is Rectangle(0, viewportHeight/4, viewportWidth, 3*viewportHeight/4, "#424242");
envelopeBackground is Rectangle(40, viewportHeight/4 + 40, viewportWidth / 1.5, 3*viewportHeight/4 / 1.5, "#000000");

# KEYS
numOctaves = 8;
keyWidth = 27;
blackKeyWidth = (3/4) * keyWidth;
keyHeight = 100;

whiteKeys is Rectangle(keyOffset[1] + keyWidth*k + keyWidth*7*octave, viewportHeight - keyHeight*1.55, keyWidth, keyHeight, "#FFFFFF", "#000000") with k is 0..6;
leftBlackKeys is Rectangle(keyOffset[1] + (keyWidth/2 + blackKeyWidth)/2 + keyWidth*k + keyWidth*7*octave, viewportHeight - keyHeight*1.55, blackKeyWidth, keyHeight/2, "#000000", "#101010") with k is 0..1;

rightBlackKeys is Rectangle(keyOffset[1] + (keyWidth/2 + blackKeyWidth)/2 + keyWidth*k + keyWidth*7*octave, viewportHeight - keyHeight*1.55, blackKeyWidth, keyHeight/2, "#000000", "#101010") with k is 3..5;

pianoKeys is [whiteKeys, leftBlackKeys, rightBlackKeys];
octaves is pianoKeys with octave is 0..7;

# ENVELOPE OPTIONS
onCheck is Checkbox("envelope_on", "On", viewportWidth/1.5 + 40, viewportHeight/4 + 40 + buttonSize * 2, false);
sustainCheck is Checkbox("envelope_on", "On", viewportWidth/1.5 + 40, viewportHeight/4 + 40 + buttonSize * 2, false);

sustainText is Text("Point" + instruments[currentInstrument].sustain);
loopFromText is Text("Start" + instruments[currentInstrument].loopFrom);
loopToText is Text("End" + instruments[currentInstrument].loopTo);

# ENVELOPE BUTTONS
sustainPlusButton is Button("sustainplus", "+");
sustainPlusButton is Button("sustainplus", "-");

loopFromPlusButton is Button("loopfromminus", "+");
loopFromMinusButton is Button("loopfromplus", "-");

loopToPlusButton is Button("looptoplus", "+");
loopToMinusButton is Button("looptominus", "-");

addButton is Button("add_point", "Add", 40 + viewportWidth/1.5, viewportHeight/4 + 40, buttonSize * 5, buttonSize * 2);
deleteButton is Button("delete_point", "Del", 40 + viewportWidth/1.5 + buttonSize * 5, viewportHeight/4 + 40, buttonSize * 5, buttonSize * 2);

instrumentButtons is [addButton, deleteButton];

instrEditor is [instrumentBackground, envelopeBackground, instrumentButtons, octaves, onCheck, pianoScroll];
}

action InitUIEvents {
    mouseHoverRow is floor((mouseY - gridOffset[2])/cellHeight);
    mouseHoverChannel is floor((mouseX - gridOffset[1])/cellWidth);

    mouseHoverInstrumentList is floor((mouseY - instrOffset[2])/fontSize);
    mouseHoverSampleList is floor((mouseY - sampleOffset[2])/fontSize);

    mouseOverInstrument is (mouseHoverInstrumentList >= 0 && mouseHoverInstrumentList <= 127 && mouseX >= viewportWidth/2 && mouseX < 3*viewportWidth/4 && mouseY < viewportHeight/4);

    mouseOverSample is (mouseHoverSampleList >= 0 && mouseHoverSampleList <= 127 && mouseX >= 3 * viewportWidth/4 && mouseX <= viewportWidth && mouseY < viewportHeight/4);

    mouseHoverElement is floor((mouseX - gridOffset[1])/(cellWidth / 5)) % 5;

    mouseOverCell is currentView == "grid" && (mouseHoverRow >= 0 && mouseHoverRow <= patternRows[currentPattern] && mouseHoverChannel >= 0 && mouseHoverChannel <= numChannels && mouseY >= viewportHeight/4);

    cellScroll = false;

    when(mouseDown) {
        if(mouseButton == "Left down" && mouseOverCell) {
            rowFocus  = mouseHoverRow;
            channelFocus = mouseHoverChannel;
            elementFocus = mouseHoverElement;
            cellScroll = true;

            if(gridFocus) {
                keyboardElementFocus = elementFocus;
                keyboardChannelFocus = channelFocus;
                keyboardRowFocus = rowFocus;
            }
        }

        if (mouseButton == "Left down" && mouseOverInstrument) {
            currentInstrument = mouseHoverInstrumentList + 1;
            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "set_view",
                    sampleId: root.lookup("currentSample").value(),
                    instrumentId: root.lookup("currentInstrument").value() - 1
                });
            }}$
        }

        if (mouseButton == "Left down" && mouseOverSample) {
            
            currentSample = mouseHoverSampleList;
            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "set_view",
                    sampleId: root.lookup("currentSample").value(),
                    instrumentId: root.lookup("currentInstrument").value() - 1
                });
            }}$
        }
    }

    when(mouseWheel) {
        if(!mousePressed || !mouseOverCell && mouseY >= viewportHeight/4 && currentView == "grid") {
            if(mouseWheelVelocity > 0 && currentRow < patternRows[currentPattern] - 1) {
                currentRow++; # change this to be an independent scroll
            } else if (mouseWheelVelocity < 0 && currentRow > 0) {
                currentRow--;
            }
        }

        if(!mousePressed || !mouseOverCell && mouseY < viewportHeight/4 && mouseX >= viewportWidth/2 && mouseX < 3*viewportWidth/4) {
            if(mouseWheelVelocity > 0 && instrScroll < 128) {
                instrScroll++; # change this to be an independent scroll
            } else if (mouseWheelVelocity < 0 && instrScroll > 0) {
                instrScroll--;
            }
        }

        if(!mousePressed || !mouseOverCell && mouseY < viewportHeight/4 && mouseX >= 3*viewportWidth/4 && mouseX < viewportWidth) {
            if(mouseWheelVelocity > 0 && sampleScroll < 16) {
                sampleScroll++; # change this to be an independent scroll
            } else if (mouseWheelVelocity < 0 && sampleScroll > 0) {
                sampleScroll--;
            }
        }
    }

    when(touchPanX) {
        if(!mousePressed || !mouseOverCell && mouseY >= viewportHeight/4 && currentView == "grid") {
            if(touchPanXSpeed > 0 && scrollHorz < 16) {
                scrollHorz += cellWidth;
            } else if (touchPanXSpeed < 0 && scrollHorz > 0) {
                scrollHorz-= cellWidth;
            }
        }

        if(!mousePressed && mouseY >= viewportHeight/4 && currentView == "instrument") {
            if(touchPanXSpeed > 0 && keyScrollHorz < 7 * numOctaves * keyWidth - viewportWidth) {
                keyScrollHorz += keyWidth;
            } else if (touchPanXSpeed < 0 && keyScrollHorz > 0) {
                keyScrollHorz-= keyWidth;

                if (keyScrollHorz < 0) {
                    keyScrollHorz = 0;
                }
            }
        }
    }

    when(elementDirty) {
        if(currentElement == 0) { # note
            setNote(elementValue, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
            patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][1] = elementValue;


            setInstrument(currentInstrument, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
            patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][2] = currentInstrument;

            setVolume(100, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
            patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][3] = 100;
        } else if (currentElement == 1) { # instrument
            temp = patternFocus[keyboardRowFocus + 1][keyboardChannelFocus + 1][currentElement + 1];

            temp = temp * 10 + elementValue;

            if(temp > 128) {
                while(temp > 128) {
                    digits = floor(log(temp)); # base 10 approximates number of digits

                    power_ten = pow(10, digits);

                    temp = temp % power_ten;
                }
            }

            setInstrument(temp, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
            patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][2] = temp;
        } else if (currentElement == 2) { # volume
            temp = patternFocus[keyboardRowFocus + 1][keyboardChannelFocus + 1][currentElement + 1];

            temp = temp * 10 + elementValue;

            if(temp > 100) {
                while(temp > 100) {
                    digits = floor(log(temp)); # base 10 approximates number of digits

                    power_ten = pow(10, digits);

                    temp = temp % power_ten;
                }
            }

            setVolume(temp, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
            patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][3] = temp;
        } else if (elementFocus == 3) { # effect
            setEffect(elementValue, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
            patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][4] = elementValue;
        } else if (elementFocus == 4) { # param
           temp = patternFocus[keyboardRowFocus + 1][keyboardChannelFocus + 1][currentElement + 1];

            temp = temp * 10 + elementValue;

            if(temp > 100) {
                while(temp > 100) {
                    digits = floor(log(temp)); # base 10 approximates number of digits

                    power_ten = pow(10, digits);

                    temp = temp % power_ten;
                }
            }

            setParam(elementValue, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
            patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][5] = elementValue;
        }

        keyboardRowFocus = (currentRow + step) % patternRows[currentPattern];
    }

    # button states
    when(patternplus_click) {
        if(currentPattern < 255) {
            currentPattern++;
        }
    }

    when(patternminus_click) {
        if(currentPattern > 1) {
            currentPattern--;
        }
    }

    when(sampleload_click) {
        createSample("smp");
    }

    when(sampleclear_click) {
        samplePool[currentSample + 1].filename = "";
        samplePool[currentSample + 1].length = 0;
        samplePool[currentSample + 1].channels = 0;
        samplePool[currentSample + 1].waveform = [];
        samplePool[currentSample + 1].loopType = 0;
        samplePool[currentSample + 1].loopFrom = 0;
        samplePool[currentSample + 1].loopTo = 0;

        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_clear",
                sampleId: root.lookup("currentSample").value()
            })
        }}$
    }

    when(sampleDirty) {
        if (sampleDirty) {
            do :project > makeui;
            sampleDirty = false;
        }
    }

    when(playbtn_click) {
        if(playbtn_click && is_playing == false) {
            is_playing = true;
        }
    }

    when(stopbtn_click) {
        if(stopbtn_click && is_playing == true) {
            is_playing = false;
        }
    }

    when(tempoplus_click) {
        if(bpm < 255) {
            bpm++;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "bpm", value: root.lookup("bpm").value()
                })
            }}$
        }
    }

    when(tempominus_click) {
        if(bpm > 10) {
            bpm--;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "bpm", value: root.lookup("bpm").value()
                })
            }}$
        }
    }

     when(speedplus_click) {
        if(ticksPerRow < 12) {
            ticksPerRow++;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "speed", value: root.lookup("ticksPerRow").value()
                })
            }}$
        }
    }

    when(speedminus_click) {
        if(bpm > 1) {
            ticksPerRow--;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "speed", value: root.lookup("ticksPerRow").value()
                })
            }}$
        }
    }

    when(octaveplus_click) {
        if (octave < 7) {
            octave++;
        }
    }

    when(octaveminus_click) {
        if (octave > 0) {
            octave--;
        }
    }

    when(stepplus_click) {
        if (step < 16) {
            step++;
        }
    }

    when(stepminus_click) {
        if (step > 0) {
            step--;
        }
    }

    when(orderinsert_click) {
        if(numOrders < 127) {
            patternOrder[numOrders + 1] = currentPattern - 1;
            numOrders++;
            # dispatch to wasm

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "insert_order",
                    pos: root.lookup("currentOrder").value(),
                    patternId: root.lookup("currentPattern").value() - 1
                });
            }}$
        }
    }

    when(orderdelete_click) {
        if(numOrders > 1) {

            numOrders--;
            # dispatch to wasm

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "delete_order",
                    pos: root.lookup("currentOrder").value(),
                    patternId: root.lookup("currentPattern").value() - 1
                })
            }}$
            currentOrder--;

            if (currentOrder < 0)
                currentOrder = 0;
        }
    }

    when(orderplus_click) {
        if (patternOrder[currentOrder + 1] < 254) {
            patternOrder[currentOrder + 1] = patternOrder[currentOrder + 1] + 1;
            currentPattern++
        }
    }

    when(orderminus_click) {
        if (patternOrder[currentOrder + 1] > 0) {
            patternOrder[currentOrder + 1] = patternOrder[currentOrder + 1] - 1;
            currentPattern--;
        }
    }

    when(orderup_click) {
        if (currentOrder > 0) {
            currentOrder--;
            currentPattern = patternOrder[currentOrder + 1] + 1;
        }
    }

    when(orderdown_click) {
        if (currentOrder < 254 && patternOrder[(currentOrder + 1) + 1] != 255) {
            currentOrder++;
            currentPattern = patternOrder[currentOrder + 1] + 1;
        }
    }

    when(sampleedit_click) {
        if (currentView == "sample") {
            currentView = "grid"
        } else {
            currentView = "sample"
        }
    }

    when(instrumentedit_click) {
        if (currentView == "instrument") {
            currentView = "grid"
        } else {
            currentView = "instrument"
        }
    }

    when(currentView) {
        if (currentView == "grid") {
            editorFocus is grid;
        } else if (currentView == "sample") {
            editorFocus is sampleEditor;
        } else if (currentView == "instrument") {
            editorFocus is instrEditor;
        }
    }

    when(keyboardRowFocus + 1) {
        currentRow = keyboardRowFocus;
    }

    when (keyboardChannelFocus + 1) {
        currentRow = keyboardRowFocus;
        currentChannel = keyboardChannelFocus;
    }

    when (keyboardElementFocus) {

        cellLeft = keyboardChannelFocus * cellWidth + keyboardElementFocus * (cellWidth / 5);

        cellRight = cellLeft + (cellWidth / 5);

        viewportLeft  = scrollHorz;
        viewportRight = scrollHorz + viewportWidth;


        if (cellRight + 40 > viewportRight) {
            scrollHorz = (cellRight + 40) - viewportWidth;
        }

        if (cellLeft < 40) {
            scrollHorz = cellLeft - 40;

            if (scrollHorz < 0) {
                scrollHorz = 0;
            }
        }

        currentRow is keyboardRowFocus;
        currentElement is keyboardElementFocus;
    }

    when(deleteDirty) { # deleteDirty triggered from JS key event
        # check the current element, remove from JS-EDEN array (set to 0)
        # dispatch message to AWP and remove from WASM array

        patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][1] = 0;
        patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][2] = 0;
        patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][3] = 0;
        patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][4] = 0;
        patternArray[currentPattern][keyboardRowFocus + 1][keyboardChannelFocus + 1][5] = 0;

        setNote(0, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
        setInstrument(0, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
        setVolume(0, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
        setEffect(0, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);
        setParam(0, currentPattern - 1, keyboardRowFocus, keyboardChannelFocus);

        deleteDirty = false;
    }

    when(expandpat_click) {
        do :project > ExpandPattern;

        ${{
           root.lookup("engine_node").value().port.postMessage(
                {
                    type: "expand_pattern",
                    patternId: root.lookup("currentPattern").value() - 1
                }
           ); 
        }}$
    }

    when(shrinkpat_click) {
        do :project > ShrinkPattern;

        ${{
           root.lookup("engine_node").value().port.postMessage(
                {
                    type: "shrink_pattern",
                    patternId: root.lookup("currentPattern").value() - 1
                }
           );
        }}$
    }

    when(addchan_click) {
        upDown = true;
        do :project > ResizeChannels;

        ${{
            root.lookup("engine_node").value().port.postMessage(
                {
                    type: "increase_channel_count"
                }
            );
        }}$
    }

    when(subchan_click) {
        upDown = false;
        do :project > ResizeChannels;

        ${{
            root.lookup("engine_node").value().port.postMessage(
                {
                    type: "decrease_channel_count"
                }
            );
        }}$
    }

    when(lenplus_click) {
        upDown = true;
        do ResizeRow;

        ${{
            root.lookup("engine_node").value().port.postMessage(
                {
                    type: "increase_row_count",
                    patternId: root.lookup("currentPattern").value() - 1
                }
            );
        }}$
    }

    when(lenminus_click) {
        upDown = false;
        do ResizeRow;

        ${{
            root.lookup("engine_node").value().port.postMessage(
                {
                    type: "decrease_row_count",
                    patternId: root.lookup("currentPattern").value() - 1
                }
            );
        }}$
    }
}

action InitSampleEditEvents {
    mouseOverWaveform is currentView == "sample" && mouseY >= viewportHeight/4 + 40 && mouseY <= (3*viewportHeight/4 / 1.5 + viewportHeight/4 + 40);

    mouseOverLoopFrom is currentView == "sample" && samplePool[currentSample + 1].loopType != 0 && (draggingLoopFrom || loopFromTri);
    mouseOverLoopTo is currentView == "sample" && samplePool[currentSample + 1].loopType != 0 && (draggingLoopTo || loopToTri);

    loopFromTri is mouseX > loopStartX && mouseX < loopStartX + 30 && mouseY > viewportHeight/4 + 40 && mouseY < viewportHeight/4 + 40 + 30 && ((mouseX - loopStartX)/30 +  (mouseY - (viewportHeight/4 + 40))/30)/2 <= 0.5;
    loopToTri is  mouseX < loopEndX && mouseX > loopEndX - 30 && mouseY < loopTriY && mouseY > loopTriY - 30 && ((loopEndX - mouseX)/30 +  (loopTriY - mouseY)/30)/2 <= 0.5;

    when(currentSample + 1) {
        selectFrom = -1;
        selectTo = -1;
    }

    when(mouseDown) {
        if (mouseOverWaveform && mouseOverLoopFrom) {
            draggingLoopFrom = true;
        } else if (mouseOverWaveform && mouseOverLoopTo) {
            draggingLoopTo = true;
        }

        if(mouseOverWaveform && !mouseOverLoopFrom && !mouseOverLoopTo && !draggingLoopFrom && !draggingLoopTo) {
            selectFrom = mouseX;
            selectTo = selectFrom;
        }
    }

    when(mouseUp) {
        if(mouseOverWaveform && !mouseOverLoopFrom && !mouseOverLoopTo && !draggingLoopFrom && !draggingLoopTo) {
            selectTo = mouseUp.x;

            if (selectFrom > selectTo) {
                temp = selectFrom;
                selectFrom = selectTo;
                selectTo = temp;
            }
        }

        draggingLoopFrom = false;
        draggingLoopTo = false;
    }

    when(mouseX) {
        if (mousePressed && mouseOverWaveform && !mouseOverLoopFrom && !mouseOverLoopTo && !draggingLoopFrom && !draggingLoopTo) {
            selectTo = mouseX;
        } else if (mousePressed && mouseOverWaveform && mouseOverLoopFrom && draggingLoopFrom) {
            newLoopPoint = floor(mouseX/viewportWidth * samplePool[currentSample + 1].length);

            if (newLoopPoint < samplePool[currentSample + 1].loopTo) {
                samplePool[currentSample + 1].loopFrom = newLoopPoint;

                ${{
                    root.lookup("engine_node").value().port.postMessage({
                        type: "set_loop_from",
                        loopFrom: root.lookup("newLoopPoint").value()
                    })
                }}$
            }
                
        } else if (mousePressed && mouseOverWaveform && mouseOverLoopTo && draggingLoopTo) {
            newLoopPoint = ceil(mouseX/viewportWidth * samplePool[currentSample + 1].length);

            if (newLoopPoint > samplePool[currentSample + 1].loopFrom) {
                samplePool[currentSample + 1].loopTo = newLoopPoint;

                ${{
                    root.lookup("engine_node").value().port.postMessage({
                        type: "set_loop_to",
                        loopTo: root.lookup("newLoopPoint").value()
                    })
                }}$
            }
                
        }
    }

    # TODO: Give these buttons functionality

    when(sampleplay_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type:"sample_play",
                sampleId: root.lookup("currentSample").value(),
                instrumentId: root.lookup("currentInstrument").value()
            })
        }}$
    }

    when(samplestop_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type:"sample_stop",
                sampleId: root.lookup("currentSample").value(),
                instrumentId: root.lookup("currentInstrument").value()
            })
        }}$
    }

    when(loadinsampleview_click) {
        createSample("smp");
    }

    when(clearinsampleview_click) {
        samplePool[currentSample + 1].filename = "";
        samplePool[currentSample + 1].length = 0;
        samplePool[currentSample + 1].channels = 0;
        samplePool[currentSample + 1].waveform = [];
        samplePool[currentSample + 1].loopType = 0;
        samplePool[currentSample + 1].loopFrom = 0;
        samplePool[currentSample + 1].loopTo = 0;

        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_clear",
                sampleId: root.lookup("currentSample").value()
            })
        }}$
    }

    when(samplecopy_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_copy",
                sampleId: root.lookup("currentSample").value(),
                from: root.lookup("sampleFrom").value(),
                to: root.lookup("sampleTo").value()
            });
        }}$
    }

    when(samplecut_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_cut",
                sampleId: root.lookup("currentSample").value(),
                from: root.lookup("sampleFrom").value(),
                to: root.lookup("sampleTo").value()
            });
        }}$
    }

    when(samplepaste_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_paste",
                sampleId: root.lookup("currentSample").value()
            });
        }}$
    }

    when(samplecrop_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_crop",
                sampleId: root.lookup("currentSample").value(),
                from: root.lookup("sampleFrom").value(),
                to: root.lookup("sampleTo").value()
            });
        }}$
    }

    when(sampleundo_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_undo",
                sampleId: root.lookup("currentSample").value(),
                from: root.lookup("sampleFrom").value(),
                to: root.lookup("sampleTo").value()
            });
        }}$
    }

    when(sampleredo_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_redo",
                sampleId: root.lookup("currentSample").value(),
                from: root.lookup("sampleFrom").value(),
                to: root.lookup("sampleTo").value()
            });
        }}$
    }

    when(samplereverse_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_reverse",
                sampleId: root.lookup("currentSample").value(),
                from: root.lookup("sampleFrom").value(),
                to: root.lookup("sampleTo").value()
            });
        }}$
    }

    when(samplenormalise_click) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "sample_normalise",
                sampleId: root.lookup("currentSample").value(),
                from: root.lookup("sampleFrom").value(),
                to: root.lookup("sampleTo").value()
            });
        }}$
    }

    when(sampleloopnone_click) {
        if (samplePool[currentSample + 1].loopType != 0) {
            samplePool[currentSample + 1].loopType = 0;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "set_loop_type",
                    sampleId: root.lookup("currentSample").value(),
                    loopType: 0
                });
            }}$
        }
    }

    when(sampleloopforward_click) {
        if (samplePool[currentSample + 1].loopType != 1) {
            if (!samplePool[currentSample + 1].loopType) {
                samplePool[currentSample + 1].loopFrom = 0;
                samplePool[currentSample + 1].loopTo = samplePool[currentSample + 1].length
            }

            samplePool[currentSample + 1].loopType = 1;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "set_loop_type",
                    sampleId: root.lookup("currentSample").value(),
                    loopType: 1
                });
            }}$

            
        }
    }

    when(sampleloopbidi_click) {
        if (samplePool[currentSample + 1].loopType != 2) {
            if (!samplePool[currentSample + 1].loopType) {
                samplePool[currentSample + 1].loopFrom = 0;
                samplePool[currentSample + 1].loopTo = samplePool[currentSample + 1].length
            }

            samplePool[currentSample + 1].loopType = 2;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "set_loop_type",
                    sampleId: root.lookup("currentSample").value(),
                    loopType: 2
                });
            }}$
        }
    }
}

action config {
## Global variables used by JS-Eden to keep track of the state of the engine inside AudioWorklet

bpm = 140;
ticksPerRow = 6;
currentOrder = 0;
currentPattern = 0;
currentRow = 0;
currentChannel = 0;
numChannels = 8;
currentInstrument = 1; # used for midi playback and drawing on grid, will have zero effect during arrangement playback

is_playing is false;
}

action MakePatterns {
    oneCell = [0, 0, 0, 0, 0];

    channelCells = oneCell with ch is 1..NUM_CHANNELS;
    rowCells = channelCells with r is 1..NUM_ROWS;
    patternArray = rowCells with i is 1..NUM_PATTERNS;

    patternOrder = 255 with i is 1..NUM_ORDERS;
    patternRows = NUM_ROWS with i is 1..NUM_PATTERNS;

    patternOrder[1] = 0;
}

action timing {
    when(bpm) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "bpm",
                value: root.lookup("bpm").value()
            })
        }}$
    }

    when(ticks_per_row) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "rows-per-beat",
                value: root.lookup("ticks_per_row").value()
            })
        }}$
    }
}


action SetupListeners {
${{
    root.lookup("is_playing").addJSObserver("playback_state", (obs, state) => {
        if(state) {
            root.lookup("engine_node").value().port.postMessage({
                type: "playstart",
                order: root.lookup("currentOrder").value()
            })
        } else {
            root.lookup("engine_node").value().port.postMessage({
                type: "playpause"
            })
        }
    })
}}$
}

action start {
    when(wasmReady) {
        do :project > MakeUI;
        do :project > MakeGrid;
        do :project > MakeInstrumentEditor;
        do :project > MakeSampleEditor;
        do :project > InitUIEvents;
        do :project > InitSampleEditEvents;
        do :project > SetupListeners;
        do :project > Timing;
    }
}

# NATIVE EVENT LISTENERS

do lib:unexecuted;
if (jseden_project_mode == "restore") do :project > ACTIVE;
if (jseden_project_mode != "safe") do :project > start;
else createView("safemode","ScriptInput");

action ACTIVE {
    views_list = ["myscript"];
    view_myscript_type = "ScriptInput";
    view_myscript_tabs = [":project > config", ":project > instruments"];
    view_myscript_current = 0;
    jseden_project_title = "Klaxon";

    # constants
    MAX_VOICES = 64;
    MAX_PATTERNS = 255;
    MAX_CHANNELS = 127;
    MAX_ROWS = 256;

    MAX_SAMPLES = 256;
    MAX_INSTRUMENTS = 128;

    NUM_PATTERNS = 255;
    NUM_ROWS = 64;
    NUM_CHANNELS = 8;
    NUM_ORDERS = 255;

    NOTE_ID = 1;
    INSTRUMENT_ID = 2;
    VOLUME = 3;
    EFFECT_ID = 4;
    PARAM = 5;

    # observables
    sampleRate = 44100;
    masterVolume = 100;

    bpm = 140;
    ticksPerRow = 6;
    currentOrder = 0;
    currentPattern = 1;

    currentRow is 0;
    currentChannel is 0;
    currentElement is 0;

    numChannels = 8;
    numOrders = 1;

    numSamples = 0;

    rowsPerPattern = 64;
    currentInstrument = 1;
    currentSample = 0;

    sampleDirty = true;
    elementDirty = false;
    deleteDirty = false;

    gridFocus = false;
    
    currentView = "grid";
    
    elementValue = 0;

    wasmReady = false;

    keyboardRowFocus = 0;
    keyboardChannelFocus = 0;
    keyboardElementFocus = 0;

    scrollHorz = 0;
    scrollVert = 0;
    instrScroll = 0;
    sampleScroll = 0;
    orderScroll = 0;

    upDown = false;

    step = 0;

    draggingLoopFrom = false;
    draggingLoopTo = false;

    selectFrom = -1;
    selectTo = -1;

    sampleFrom is floor(selectFrom / viewportWidth * samplePool[currentSample + 1].length);
    sampleTo is ceil(selectTo / viewportWidth * samplePool[currentSample + 1].length) if (selectTo != selectFrom) else sampleFrom;

    is_playing is false;
    order = 0 with i is 1..255;
    keys = 0 with i is 0..119;
    semitones = ["C‒", "C#", "D-", "D#", "E‒", "F‒", "F#", "G‒", "G#", "A-", "A#", "B-"];
    octave = 4;

    samplePlayheads = [];
    envelopePlayheads = [];

    numSamplePlayheads = 0;
    numEnvelopePlayheads = 0;

    tempFrom = 0;
    tempTo = 0;

    instrument_list = InstrumentList("instrument_list");

    do :project > MakePatterns;
}