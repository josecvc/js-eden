"use cs3;"

/**
 * @title Start Your Model
 */

func initAudioContext {
        ${{
            const audio_context = new AudioContext();
            return audio_context;
        }}$;
    }

func initGainNode {
    ${{
        gainNode = root.lookup("ctx").value().createGain();
        gainNode.connect(root.lookup("ctx").value().destination);
        gainNode.gain.value = 1;
        return gainNode;
    }}$;
}

# nodes used to play audio
ctx is initAudioContext();
gain_node is initGainNode();
engine_node is null; # this specifically is for holding the engine

NUM_PATTERNS is 255;
NUM_ROWS is 64;
NUM_CHANNELS is 8;
NUM_ORDERS is 255;

size is NUM_PATTERNS * NUM_ROWS * NUM_CHANNELS;

noteBuffer = ${{new SharedArrayBuffer(Uint8Array.BYTES_PER_ELEMENT * root.lookup("size").value())}}$;
instrBuffer = ${{new SharedArrayBuffer(Uint8Array.BYTES_PER_ELEMENT * root.lookup("size").value())}}$;
volBuffer = ${{new SharedArrayBuffer(Uint8Array.BYTES_PER_ELEMENT * root.lookup("size").value())}}$;
effectBuffer = ${{new SharedArrayBuffer(Uint8Array.BYTES_PER_ELEMENT * root.lookup("size").value())}}$;
paramBuffer = ${{new SharedArrayBuffer(Uint8Array.BYTES_PER_ELEMENT * root.lookup("size").value())}}$;

rowBuffer = ${{new SharedArrayBuffer(Uint16Array.BYTES_PER_ELEMENT * root.lookup("NUM_PATTERNS").value())}}$;
offsetBuffer = ${{new SharedArrayBuffer(Uint32Array.BYTES_PER_ELEMENT * root.lookup("NUM_PATTERNS").value())}}$;
orderBuffer = ${{new SharedArrayBuffer(Uint8Array.BYTES_PER_ELEMENT * root.lookup("NUM_ORDERS").value())}}$;

playbackBuffer = ${{new SharedArrayBuffer(Uint16Array.BYTES_PER_ELEMENT * 3);}}$


noteArray = ${{new Uint8Array(root.lookup("noteBuffer").value())}}$;
instrArray = ${{new Uint8Array(root.lookup("instrBuffer").value())}}$;
volArray = ${{new Uint8Array(root.lookup("volBuffer").value())}}$;
effectArray = ${{new Uint8Array(root.lookup("effectBuffer").value())}}$;
paramArray = ${{new Uint8Array(root.lookup("paramBuffer").value())}}$;

patternRows = ${{new Uint16Array(root.lookup("rowBuffer").value())}}$;
patternOffset = ${{new Uint32Array(root.lookup("offsetBuffer").value())}}$;
patternOrder = ${{new Uint8Array(root.lookup("orderBuffer").value())}}$;

playbackArray = ${{new Uint8Array(root.lookup("playbackBuffer").value());}}$

${{
    // Create SharedArrayBuffer
    // Init Engine with 64 rows per pattern with 8 channels

    const NUM_PATTERNS = 255;
    const NUM_ROWS = 64;
    const NUM_CHANNELS = 8;
    const NUM_ORDERS = 255;

    // init patterns with 64 rows
    for(let p = 0; p < NUM_PATTERNS; p++) {
        root.lookup("patternRows").value()[p] = NUM_ROWS;
    }

    let offset = 0;

    for(let p = 0; p < NUM_PATTERNS; p++) {
        root.lookup("patternOffset").value()[p] = offset;
        offset += root.lookup("patternRows").value()[p] * NUM_CHANNELS;
    }
    
    root.lookup("ctx").value().audioWorklet.addModule("../../klaxon-engine/js/audio-base.js").then(() => {
        console.log(
            root.lookup("ctx").value().sampleRate
        )
        const node = new AudioWorkletNode(root.lookup("ctx").value(), "mixer-processor", {numberOfOutputs: 1, outputChannelCount: [2]});

        node.connect(root.lookup("gain_node").value());
        
        fetch("../../klaxon-engine/build/dsp.wasm").then((res) => {
            if(res.ok) {
                res.arrayBuffer().then((buffer) => {
                node.port.postMessage({
                    type: "wasm",
                    wasm: buffer,
                    sampleRate: root.lookup("ctx").value().sampleRate,
                    bpm: 140,
                    ticksPerRow: 6,
                    buffers:  {
                        note: root.lookup("noteArray").value(),
                        instr: root.lookup("instrArray").value(),
                        vol: root.lookup("volArray").value(),
                        effect: root.lookup("effectArray").value(),
                        param: root.lookup("paramArray").value(),
                        rows: root.lookup("patternRows").value(),
                        offset: root.lookup("patternOffset").value(),
                        order: root.lookup("patternOrder").value(),
                        playback: root.lookup("playbackArray").value()
                    },
                    sizes: {
                        patterns: 255,
                        channels: 8,
                        totalCells: 255 * 8 * 64,
                        orders: 1
                    }
                    })
                }).catch((e) => console.log("Error: Failed to post message to AudioWorkerNode\n" + e));
            } else {
                throw new Error(res.status);
            }
            
        }).catch((e) => {console.log("Error: Failed to retrieve WebAssembly module.\n" + e);})

        node.port.onmessage = (e) => {
            console.log(e.data);
        };

        root.lookup("engine_node").assign(node, root.scope, Eden.EdenSymbol.defaultAgent);
    }).catch((e) => {
        console.log("Error: Audio Processor failed to initialise.\n" + e);
    });
}}$;

${{
    const keysDown = new Set();
    const transpose = 12;
    const multiplier = 1;
    const keyToNote = { // MIDI
    "KeyQ" :   60 + transpose*multiplier, // C 4
    "Digit2" : 61 + transpose*multiplier, // C# 4/Db 4
    "KeyW" :   62 + transpose*multiplier, // D 4
    "Digit3" : 63 + transpose*multiplier, // D# 4/Eb 4
    "KeyE" :   64 + transpose*multiplier, // E 4
    "KeyR" :   65 + transpose*multiplier, // F 4
    "Digit5" : 66 + transpose*multiplier, // F# 4/Gb 4
    "KeyT" :   67 + transpose*multiplier, // G 4
    "Digit6" : 68 + transpose*multiplier, // G# 4/Ab 4
    "KeyY" :   69 + transpose*multiplier, // A 4
    "Digit7" : 70 + transpose*multiplier, // A# 4/Bb 4
    "KeyU" :   71 + transpose*multiplier, // B 4
    "KeyI" :   72 + transpose*multiplier, // C 5
    "Digit9" : 73 + transpose*multiplier, // C# 5/Db 5
    "KeyO" :   74 + transpose*multiplier, // D 5
    "Digit0" : 75 + transpose*multiplier, // D# 5/ Eb 5
    "KeyP" :   76 + transpose*multiplier // E
    }


    addEventListener("keydown", (e) => {    
        const code = e.code;
        if(!keyToNote.hasOwnProperty(code)) return;

        const element = document.activeElement;
        
        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        if(root.lookup("is_playing").value()) return;

        if(!keysDown.has(code)) {
            keysDown.add(code);
            root.lookup("engine_node").value().port.postMessage({
                type: "note_on",
                note: keyToNote[code],
                instrumentId: root.lookup("current_instrument").value()
            })
        }
        
    })

    addEventListener("keyup", (e) => {
        const code = e.code;

        const element = document.activeElement;

        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        if(root.lookup("is_playing").value()) return;
        
        if(keyToNote.hasOwnProperty(code)) {
            keysDown.delete(code);
            root.lookup("engine_node").value().port.postMessage({
                type: "note_off",
                note: keyToNote[code],
                instrumentId: root.lookup("current_instrument").value()
            })
        }
    })
}}$;

${{
Sample = function(obsName) {
    this.obsName = obsName;
    this.duration = 0;
    this.filename = "";
    this.sampleRate = 0;
}
}}$;

${{
