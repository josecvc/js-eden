## ACTIONS

action makeui {
# Set up canvas
createCanvas("PatternEditor", "editorCanvas", "Klaxon Tracker");
patternFocus = getPattern(currentPattern - 1, numChannels);

mouseWheelEnabled = true;
view_PatternEditor_width = 1193;
view_PatternEditor_height = 843;
view_PatternEditor_x = 295.5;
view_PatternEditor_y = 8.5;

scale = 0.75;
fontSize is 30 * scale;
buttonSize is 30 * scale;

# Cell Size
cellWidth is view_PatternEditor_width/6 * scale;
cellHeight is view_PatternEditor_height/24 * scale;

gridOffset  is [40, 3 * view_PatternEditor_height / 4 - currentRow*cellHeight]
orderOffset is [view_PatternEditor_width/50,  view_PatternEditor_height / 16 - (currentOrder+1)*fontSize + 7]

# Covers
topCover is Rectangle(0, 0, view_PatternEditor_width, view_PatternEditor_height/2, "#625353", "#000000"); # add gradient afterwards
bottomCover is Rectangle(0, view_PatternEditor_height/2, view_PatternEditor_width, view_PatternEditor_height/2, "#74747400", "#000000");
channelRect is Rectangle(ch*cellWidth + gridOffset[1], view_PatternEditor_height/2 , cellWidth, view_PatternEditor_height/2, "#00000000", "#000000") with ch is 0..(numChannels - 1);

instrumentsBg is Rectangle(view_PatternEditor_width/2, 0, view_PatternEditor_width/2, view_PatternEditor_height/4, "#784545", "#000000");
samplesBg is Rectangle(view_PatternEditor_width/2, view_PatternEditor_height/4, view_PatternEditor_width/2, view_PatternEditor_height/4, "#784545", "#000000");

orderBackground is Rectangle(0, 0, view_PatternEditor_width/8, view_PatternEditor_height/8, "#784545", "#000000");
orderSeqSep is Rectangle(0, 0, view_PatternEditor_width/16, view_PatternEditor_height/8, "#00000000", "#000000");
orderPatSep is Rectangle(view_PatternEditor_width/16, 0, view_PatternEditor_width/16, view_PatternEditor_height/8, "#00000000", "#000000");

# Buttons
playButton is Button("playbtn", "Play", 0, view_PatternEditor_height/4, buttonSize * 4, buttonSize * 2);
stopButton is Button("stopbtn", "Stop", 0, view_PatternEditor_height/4 + buttonSize * 2, buttonSize * 4, buttonSize * 2);

tempoPlusButton is Button("tempoplus",   "+", view_PatternEditor_width/4.5, view_PatternEditor_height/15      , buttonSize, buttonSize);
tempoMinusButton is Button("tempominus", "-", view_PatternEditor_width/4.5 + buttonSize, view_PatternEditor_height/15, buttonSize, buttonSize);

speedPlusButton is Button("speedplus", "+", view_PatternEditor_width/4.5, view_PatternEditor_height/15 + buttonSize, buttonSize, buttonSize);
speedMinusButton is Button("speedminus", "-", view_PatternEditor_width/4.5 + buttonSize, view_PatternEditor_height/15 + buttonSize, buttonSize, buttonSize);

patternPlusButton is Button("patternplus", "+", view_PatternEditor_width/2.75, view_PatternEditor_height/15, buttonSize, buttonSize);
patternMinusButton is Button("patternminus", "-", view_PatternEditor_width/2.75 + buttonSize, view_PatternEditor_height/15, buttonSize, buttonSize);

orderInsertButton is Button("orderinsert", "Ins.", 0, view_PatternEditor_height/8, buttonSize*2, buttonSize);
orderDelButton is Button("orderdelete", "Del.", buttonSize*2, view_PatternEditor_height/8, buttonSize*2, buttonSize);

sampleLoadButton is Button("sampleload", "Load", view_PatternEditor_width/2 + fontSize*4, view_PatternEditor_height/4, buttonSize*2, buttonSize);
sampleClearButton is Button("sampleclear", "Clear", view_PatternEditor_width/2 + buttonSize*2 + fontSize*4, view_PatternEditor_height/4, buttonSize*2, buttonSize);

buttons is [playButton, stopButton, tempoPlusButton, tempoMinusButton, 
    speedPlusButton, speedMinusButton, patternPlusButton, patternMinusButton, 
    orderInsertButton, orderDelButton, sampleLoadButton, sampleClearButton
];

# Information
titleText is Text("KlaxonTracker", 3 * view_PatternEditor_width/16, 0, fontSize * 2, "white", "bold");
instrIndicator is Text("Instruments", view_PatternEditor_width/2, 0, fontSize, "white");
sampleIndicator is Text("Samples", view_PatternEditor_width/2, view_PatternEditor_height/4, fontSize, "white");

tempoText is Text("BPM  " + bpm, view_PatternEditor_width/8, view_PatternEditor_height/14, fontSize, "white", "#CBE5D4");
speedText is Text("SPD  " + ticksPerRow, view_PatternEditor_width/8, view_PatternEditor_height/14 + fontSize, fontSize, "white", "#CBE5D4");
patternIDTxt is Text("Pattern: " + (currentPattern - 1), view_PatternEditor_width/4 + buttonSize, view_PatternEditor_height/14, fontSize, "white", "#CBE5D4");

information is [titleText, tempoText, speedText, patternIDTxt, instrIndicator, sampleIndicator];

# Order Rendering
seqClassifier is "0" + s if(s < 10) else s;
patClassifier is "0" + patternOrder[s+1] if (patternOrder[s+1] < 10) else patternOrder[s+1];

orderCell is Rectangle(0, 0 + orderOffset[2], cellWidth, cellHeight, "#c95757");

seqNum  is Text(seqClassifier, 0 + orderOffset[1], s*fontSize + orderOffset[2], fontSize, "black" if s == currentOrder else "white") with s is 0..(numOrders - 1);
patNum is Text(patClassifier, view_PatternEditor_width/16 + orderOffset[1], s*fontSize + orderOffset[2], fontSize, "black" if s == currentOrder else "white") with s is 0..(numOrders - 1);

orderRender is [orderBackground, orderCell, seqNum, patNum, orderPatSep, orderSeqSep];

# Sample List Rendering
sampleNum is Text(seqClassifier, 0 + orderOffset[1], s*fontSize + orderOffset[2], fontSize, "black" if s == currentOrder else "white") with s is 0..( - 1);

sampleListRender is [sampleNum]

# Grid Rendering
channelIDTxt is Text(ch+1, ch * cellWidth + gridOffset[1], view_PatternEditor_height/2 + 5, 30, "black", "bold") with ch is 0..(numChannels - 1);
rowNos is Text(r if r > 9 else "0" + r, 0*cellWidth, r*cellHeight + gridOffset[2], cellHeight, "black") with r is 0..63
gridCell is Rectangle(x*cellWidth + gridOffset[1], y*cellHeight + gridOffset[2], cellWidth, cellHeight, "#c7dbb0" if (y == currentRow) else "gray" if (y % 4 == 0) else "#dfdfdf", "#000000");

# Cell Mutation
noteClassifier is midi2note(patternFocus[r+1][ch+1][1]) if (patternFocus[r+1][ch+1][1] >= 12 && patternFocus[r+1][ch+1][1] <= 119) else "---";
instrClassifier is patternFocus[r+1][ch+1][2] if (patternFocus[r+1][ch+1][2] >= 1 && patternFocus[r+1][ch+1][2] <= 255) else "--";
volClassifier is patternFocus[r+1][ch+1][3] if (patternFocus[r+1][ch+1][3] >= 1 && patternFocus[r+1][ch+1][3] <= 100) else "--";
effectClassifier is int2char(patternFocus[r+1][ch+1][4]) if (patternFocus[r+1][ch+1][4] >= 1 && patternFocus[r+1][ch+1][4] <= 26) else "-";
paramClassifier is int2hex(patternFocus[r+1][ch+1][5]) if (patternFocus[r+1][ch+1][5] >= 1 && patternFocus[r+1][ch+1][5] <= 255) else "--";

# Cell Text
noteText   is Text(noteClassifier            , ch*cellWidth + gridOffset[1] + cellWidth/30             , r*cellHeight + gridOffset[2], 22 *  scale, "black") with ch is 0..(numChannels - 1), r is 0..63;
instrText  is Text(instrClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 + cellWidth/15 , r*cellHeight + gridOffset[2], 22 * scale, "black") with ch is 0..(numChannels - 1), r is 0..63;
volText    is Text(volClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 2  + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "black") with ch is 0..(numChannels - 1), r is 0..63;
effectText is Text(effectClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 3  + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "black") with ch is 0..(numChannels - 1), r is 0..63;
paramText is Text(paramClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 4 + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "black") with ch is 0..(numChannels - 1), r is 0..63;

gridBase is gridCell with x is 0..(numChannels - 1), y is 0..63;

grid is [gridBase, rowNos, noteText, instrText, volText, effectText, paramText, channelIDTxt, channelRect];

# In render order
editorCanvas is [bottomCover, grid, topCover, instrumentsBg, samplesBg, orderBg, orderRender, information, buttons];
}

action initUIevents {
    mouseHoverRow is floor((mouseY - gridOffset[2])/cellHeight);
    mouseHoverChannel is floor((mouseX - gridOffset[1])/cellWidth);

    mouseHoverElement is floor((mouseX - gridOffset[1])/(cellWidth / 5)) % 5;

    mouseOverCell is (mouseHoverRow >= 0 && mouseHoverRow <= 63 && mouseHoverChannel >= 0 && mouseHoverChannel <= 3 && mouseY >= view_PatternEditor_height/2);

    cellScroll = false;


    when(mouseDown) {
        if(mouseButton == "Left down" && mouseOverCell) {
            rowFocus  = mouseHoverRow;
            channelFocus = mouseHoverChannel;
            elementFocus = mouseHoverElement;
            cellScroll = true;
            ${{console.log(root.lookup("elementFocus").value())}}$
            
        }
    }

    when(mouseWheel) {
        if(!mousePressed || !mouseOverCell && mouseY >= view_PatternEditor_height/2) {
            ${{console.log("Scrolling...")}}$
            if(mouseWheelVelocity > 0) {
                currentRow++;
            } else if (mouseWheelVelocity < 0) {
                currentRow--;
            }
        } else if (mouseOverCell) {
            idx = patternOffset[currentPattern] +  (rowFocus * numChannels + channelFocus) * 5 + 1; # 1-indexed
            if(elementFocus == 0) { # note
                temp = patternArray[idx];
                
                if(mouseWheelVelocity < 0 && temp < 119) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setNote(temp, idx - 1 + 0);
            } else if (elementFocus == 1) { # instrument
                temp = patternArray[idx + 1];

                if(mouseWheelVelocity < 0 && temp < 127) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setInstrument(temp, idx - 1 + 1);
            } else if (elementFocus == 2) { # volume
                temp = patternArray[idx + 2];
                
                if(mouseWheelVelocity < 0 && temp < 100) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setVolume(temp, idx - 1 + 2);
            } else if (elementFocus == 3) { # effect
                temp = patternArray[idx + 3];
                
                if(mouseWheelVelocity < 0 && temp < 26) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setEffect(temp, idx - 1 + 3);
            } else if (elementFocus == 4) { # param
                temp = patternArray[idx + 4];
                
                if(mouseWheelVelocity < 0 && temp < 255) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setParam(temp, idx - 1 + 4);
            }
        }
    }

    when(currentPattern) {
        patternFocus = getPattern(currentPattern - 1, numChannels);
    }

    when(patternDirty) {
        if(patternDirty) {
            patternFocus = getPattern(currentPattern - 1, numChannels);
            patternDirty = false;
        }
    }   


    btn is Button("mybutton", "THIS", 0, 0);
    when(mybutton_click) {
        if(mybutton_click) {
            x = 5;
        }
    }
}
action instruments {
## Define instruments here
# Use Sample() and Synth(), then add to instruments


}

action config {
## Global variables used by JS-Eden to keep track of the state of the engine inside AudioWorklet

bpm = 140;
ticksPerRow = 6;
currentOrder = 0;
currentPattern = 0;
currentRow = 0;
numChannels = 8;
current_instrument = 1; # used for midi playback, will have zero effect during arrangement playback

is_playing is false;
}

action timing {
    when(bpm) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "bpm",
                value: root.lookup("bpm").value()
            })
        }}$
    }

    when(ticks_per_row) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "rows-per-beat",
                value: root.lookup("ticks_per_row").value()
            })
        }}$
    }
}


action setuplisteners {
${{
    root.lookup("is_playing").addJSObserver("playback_state", (obs, state) => {
        if(state) {
            root.lookup("engine_node").value().port.postMessage({
                type: "playstart",
                order: root.lookup("pattern_order").value()
            })
        } else {
            root.lookup("engine_node").value().port.postMessage({
                type: "playpause"
            })
        }
    })
}}$
}

action start {
    do :project > makeui;
    do :project > initUIevents;
    do :project > setuplisteners;
    do :project > timing;
}

# NATIVE EVENT LISTENERS

do lib:unexecuted;
if (jseden_project_mode == "restore") do :project > ACTIVE;
if (jseden_project_mode != "safe") do :project > start;
else createView("safemode","ScriptInput");

action ACTIVE {
    views_list = ["myscript"];
    view_myscript_type = "ScriptInput";
    view_myscript_tabs = [":project > config", ":project > instruments"];
    view_myscript_current = 0;
    jseden_project_title = "Klaxon";

    MAX_PATTERNS = 255;
    MAX_CHANNELS = 127;
    MAX_ROWS = 256;

    bpm = 140;
    ticksPerRow = 6;
    currentOrder = 0;
    currentPattern = 1;
    currentRow = 0;
    numChannels = 8;
    numOrders = 1;

    numSamples = 0;

    rowsPerPattern = 64;
    current_instrument = 1;

    patternDirty = false;
    ready = false;

    is_playing is false;
    order = 0 with i is 1..255;
    instrument_list = InstrumentList("instrument_list");
}