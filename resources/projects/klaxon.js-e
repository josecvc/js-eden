# INSTRUMENT_LIST JS FUNCTIONS
${{
    // TODO: Make this reflect in the engine
    InstrumentList.prototype.addInstrument = function(inst) {
        this.instruments.push(inst);
    }

    InstrumentList.prototype.removeInstrument = function(instId) {
        if(instId < 0 || instId >= this.instruments.length) return;

        this.instruments.splice(instId, 1);
    }

    InstrumentList.prototype.popInstrument = function() {
        if(this.instruments.length == 0) return;

        this.instruments.pop();
    }

    InstrumentList.prototype.getNumInstruments = function() {
        return this.instruments.length;
    }
}}$

## INSTRUMENT JS-EDEN FUNCTIONS
proc addInstrument {
    para inst
    ${{
        let i = inst;

        root.lookup("instrument_list").value().addInstrument(i);
    }}$
}

proc removeInstrument {
    para instId
    ${{
        root.lookup("instrument_list").value().removeInstrument(instId);
    }}$
}

proc popInstrument {
    ${{
        root.lookup("instrument_list").value().popInstrument();
    }}$
}

function getNumInstruments {
    ${{
       return root.lookup("instrument_list").value().getNumInstruments();
    }}$
}

proc createSample {
    para obsName
    smp = Sample(obsName);
    addInstrument(smp);
}

proc createSynth {
    para obsName
    synth = Synth(obsName);
    addInstrument(synth);
}

## MIDI2NOTE

func midi2note {
    para midi;
    ${{
        const midiToKey = {
             0: "C‒",  1: "C#",
             2: "D‒",  3: "D#",
             4: "E‒",  
             5: "F‒",  6: "F#",
             7: "G‒",  8: "G#",
             9: "A‒", 10: "A#",
            11: "B‒"
        }

        const octave = Math.floor(midi / 12) - 1;

        const semitone = midiToKey[midi % 12];

        return semitone + octave.toString();
    }}$
}

func int2hex {
    para num;
    ${{
        return num.toString(16).padStart(2, "0").toUpperCase();
    }}$
}

func int2char {
    para num;
    ${{
        const c = String.fromCodePoint(65 + num - 1);
        return c;
    }}$
}

func getPattern {
    ${{
        let pattern_id = arguments[0];
        let num_channels = arguments[1];
        console.log(`Getting Pattern ${pattern_id}...`);
        const patternStart = root.lookup("patternOffset").value()[pattern_id];
        const rows = root.lookup("patternRows").value()[pattern_id];

        const patterns = root.lookup("patternArray").value();
        console.log(patterns.length)

        const pattern = [];

        const numElements = 5;

        for(let r = 0; r < rows; r++) {
            const row = []
            for(let ch = 0; ch < num_channels; ch++) {
                let idx = patternStart + (r * num_channels + ch) * numElements;
                const noteId =   patterns[idx];
                const instrId =  patterns[idx+1];
                const volume =   patterns[idx+2];
                const effectId = patterns[idx+3];
                const param =    patterns[idx+4];

                row.push([
                    noteId,
                    instrId,
                    volume,
                    effectId,
                    param
                ])
            }

            pattern.push(row);
        }
        
        return pattern;
    }}$
}

func setNote {
    para noteId, idx
    ${{root.lookup("patternArray").value()[idx] = noteId;}}$
    patternDirty = true;
}

func setInstrument {
    para instrId, idx
    ${{root.lookup("patternArray").value()[idx] = instrId;}}$
    patternDirty = true;
}

func setVolume {
    para volume, idx
    ${{root.lookup("patternArray").value()[idx] = volume;}}$
    patternDirty = true;
}

func setEffect {
    para effectId, idx
    ${{root.lookup("patternArray").value()[idx] = effectId;}}$
    patternDirty = true;
}

func setParam {
    para param, idx
    ${{root.lookup("patternArray").value()[idx] = param;}}$
    patternDirty = true;
}

