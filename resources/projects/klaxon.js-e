action makeui {
# Set up canvas
createCanvas("PatternEditor", "editorCanvas", "Klaxon Tracker");
patternFocus = getPattern(currentPattern - 1, numChannels);

mouseWheelEnabled = true;
view_PatternEditor_width = 1193;
view_PatternEditor_height = 843;
view_PatternEditor_x = 295.5;
view_PatternEditor_y = 8.5;

scale = 0.75;
fontSize is 30 * scale;
buttonSize is 30 * scale;

# Cell Size
cellWidth is view_PatternEditor_width/6 * scale;
cellHeight is view_PatternEditor_height/24 * scale;

gridOffset  is [40 - scrollHorz, view_PatternEditor_height/1.7 - (currentRow)*cellHeight]
orderOffset is [view_PatternEditor_width/50,  view_PatternEditor_height / 16 - (currentOrder+1)*fontSize + 7]


# Covers
topCover is Rectangle(0, 0, view_PatternEditor_width, view_PatternEditor_height/4, "#625353", "#000000"); # add gradient afterwards
bottomCover is Rectangle(0, view_PatternEditor_height/4, view_PatternEditor_width, 3*view_PatternEditor_height/4 - view_PatternEditor_height/28, "#74747400", "#000000");
channelRect is Rectangle(ch*cellWidth + gridOffset[1], view_PatternEditor_height/4 , cellWidth, 3*view_PatternEditor_height/4, "#00000000", "#000000") with ch is 0..(numChannels - 1);
rowNoStrip is Rectangle(0, view_PatternEditor_height/4, 40, 3*view_PatternEditor_height/4, "white", "black");

instrumentsBg is Rectangle(view_PatternEditor_width/2, 0, view_PatternEditor_width/4, view_PatternEditor_height/4, "#784545", "#000000");
samplesBg is Rectangle(3*view_PatternEditor_width/4, 0, view_PatternEditor_width/4, view_PatternEditor_height/4, "#784545", "#000000");

orderBackground is Rectangle(0, 0, view_PatternEditor_width/8, view_PatternEditor_height/8, "#784545", "#000000");
orderSeqSep is Rectangle(0, 0, view_PatternEditor_width/16, view_PatternEditor_height/8, "#00000000", "#000000");
orderPatSep is Rectangle(view_PatternEditor_width/16, 0, view_PatternEditor_width/16, view_PatternEditor_height/8, "#00000000", "#000000");

instrSep is Rectangle(view_PatternEditor_width/2, 0, view_PatternEditor_width/4, view_PatternEditor_height/4, "#00000000", "#000000");
sampSep is Rectangle(3*view_PatternEditor_width/4, 0, view_PatternEditor_width/4, view_PatternEditor_height/4, "#00000000", "#000000");

# Buttons
playButton is Button("playbtn", "Play", 0, view_PatternEditor_height/8 + buttonSize, buttonSize * 4, buttonSize * 1.5);
stopButton is Button("stopbtn", "Stop", 0, view_PatternEditor_height/8 + buttonSize + buttonSize * 1.5, buttonSize * 4, buttonSize * 1.5);

tempoPlusButton is Button("tempoplus",   "+", view_PatternEditor_width/4.5, view_PatternEditor_height/15      , buttonSize, buttonSize);
tempoMinusButton is Button("tempominus", "-", view_PatternEditor_width/4.5 + buttonSize, view_PatternEditor_height/15, buttonSize, buttonSize);

speedPlusButton is Button("speedplus", "+", view_PatternEditor_width/4.5, view_PatternEditor_height/15 + buttonSize, buttonSize, buttonSize);
speedMinusButton is Button("speedminus", "-", view_PatternEditor_width/4.5 + buttonSize, view_PatternEditor_height/15 + buttonSize, buttonSize, buttonSize);

patternPlusButton is Button("patternplus", "+", view_PatternEditor_width/2.75, view_PatternEditor_height/15, buttonSize, buttonSize);
patternMinusButton is Button("patternminus", "-", view_PatternEditor_width/2.75 + buttonSize, view_PatternEditor_height/15, buttonSize, buttonSize);

octavePlusButton is Button("octaveplus", "+", view_PatternEditor_width/2.75, view_PatternEditor_height/15 + buttonSize, buttonSize, buttonSize);
octaveMinusButton is Button("octaveminus", "-", view_PatternEditor_width/2.75 + buttonSize, view_PatternEditor_height/15 + buttonSize, buttonSize, buttonSize);

orderInsertButton is Button("orderinsert", "Ins.", 0, view_PatternEditor_height/8, buttonSize*2, buttonSize);
orderDelButton is Button("orderdelete", "Del.", buttonSize*2, view_PatternEditor_height/8, buttonSize*2, buttonSize);

sampleLoadButton is Button("sampleload", "Load", 3*view_PatternEditor_width/4 + fontSize*4, 0, buttonSize*2, buttonSize);
sampleClearButton is Button("sampleclear", "Clear", 3*view_PatternEditor_width/4 + buttonSize*2 + fontSize*4, 0, buttonSize*2, buttonSize);

sampleEditButton is Button("sampleedit", "Smp Edit", buttonSize*4, view_PatternEditor_height/8 + buttonSize, buttonSize*4, buttonSize * 1.5);

instrumentEditButton is Button("instrumentedit", "Instr Edit", buttonSize*4, view_PatternEditor_height/8 + buttonSize + buttonSize * 1.5, buttonSize * 4, buttonSize * 1.5);

buttons is [playButton, stopButton, tempoPlusButton, tempoMinusButton, 
    speedPlusButton, speedMinusButton, patternPlusButton, patternMinusButton, 
    orderInsertButton, orderDelButton, sampleLoadButton, sampleClearButton,
    sampleEditButton, instrumentEditButton, octavePlusButton, octaveMinusButton
];

# Div("<h1></h1>", 0, 0, 1, 1, "font: serif");

# Information
titleText is Text("KlaxonTracker", 3 * view_PatternEditor_width/16, 0, fontSize * 2, "white", "bold", Object("css_class_list", "klaxon-heading"));
instrIndicator is Text("Instruments", view_PatternEditor_width/2, 0, fontSize, "white");
sampleIndicator is Text("Samples", 3*view_PatternEditor_width/4, 0, fontSize, "white");

tempoText is Text("BPM  " + bpm, view_PatternEditor_width/8, view_PatternEditor_height/14, fontSize, "white", "#CBE5D4");
speedText is Text("SPD  " + ticksPerRow, view_PatternEditor_width/8, view_PatternEditor_height/14 + fontSize, fontSize, "white", "#CBE5D4");
patternIDTxt is Text("Pattern: " + (currentPattern - 1), view_PatternEditor_width/4 + buttonSize, view_PatternEditor_height/14, fontSize, "white", "#CBE5D4");

octaveText is Text("Octave: " + octave, view_PatternEditor_width/4 + buttonSize, view_PatternEditor_height/14 + fontSize, fontSize, "white", "#CBE5D4");

information is [titleText, tempoText, speedText, patternIDTxt, octaveText, instrIndicator, sampleIndicator];

# Order Rendering
seqClassifier is "0" + s if(s < 10) else s;
patClassifier is "0" + patternOrder[s+1] if (patternOrder[s+1] < 10) else patternOrder[s+1];

orderCell is Rectangle(0, 0 + orderOffset[2], cellWidth, cellHeight, "#c95757");

seqNum  is Text(seqClassifier, 0 + orderOffset[1], s*fontSize + orderOffset[2], fontSize, "black" if s == currentOrder else "white") with s is 0..(numOrders - 1);
patNum is Text(patClassifier, view_PatternEditor_width/16 + orderOffset[1], s*fontSize + orderOffset[2], fontSize, "black" if s == currentOrder else "white") with s is 0..(numOrders - 1);

orderRender is [orderBackground, orderCell, seqNum, patNum, orderPatSep, orderSeqSep];

# Instrument List Rendering

instrName is Textbox()

instrNum is Text(s, view_PatternEditor_width/2, (s - 1)*fontSize + orderOffset[2], fontSize, "black" if s == current_instrument else "white") with s is 1..128;

instrListRender is [instrumentsBg, instrNum, instrSep]

# Sample List Rendering
sampleNum is Text(s, 3 * view_PatternEditor_width/4, s*fontSize + orderOffset[2], fontSize, "black" if s == currentSample else "white") with s is 0..15;

sampleName is samplePool[s+1].filename if (s+1 <= samplePool.length) else "";

sampleText is Text(sampleName, 3 * view_PatternEditor_width/4 + fontSize, s*fontSize + orderOffset[2], fontSize, "black" if s == currentSample else "white") with s is 0..15;

sampleListRender is [samplesBg, sampleNum, sampleText, sampleSep]

# Grid Rendering
channelIDTxt is Text(ch+1, ch * cellWidth + gridOffset[1], view_PatternEditor_height/4 + 5, 30, "black", "bold") with ch is 0..(numChannels - 1);
rowNos is Text(r if r > 9 else "0" + r, 0*cellWidth, r*cellHeight + gridOffset[2], cellHeight, "black") with r is 0..63
gridCell is Rectangle(x*cellWidth + gridOffset[1], y*cellHeight + gridOffset[2], cellWidth, cellHeight, "#c7dbb0" if (y == currentRow) else "gray" if (y % 4 == 0) else "#dfdfdf", "#000000");

# Cell Mutation

noteString is semitones[(patternFocus[r+1][ch+1][1] % 12) + 1] + (floor(patternFocus[r+1][ch+1][1] / 12) - 1);

noteClassifier is noteString if (patternFocus[r+1][ch+1][1] >= 12 && patternFocus[r+1][ch+1][1] <= 119) else "---";
instrClassifier is patternFocus[r+1][ch+1][2] if (patternFocus[r+1][ch+1][2] >= 1 && patternFocus[r+1][ch+1][2] <= 255) else "--";
volClassifier is patternFocus[r+1][ch+1][3] if (patternFocus[r+1][ch+1][3] >= 1 && patternFocus[r+1][ch+1][3] <= 100) else "--";
effectClassifier is int2char(patternFocus[r+1][ch+1][4]) if (patternFocus[r+1][ch+1][4] >= 1 && patternFocus[r+1][ch+1][4] <= 26) else "-";
paramClassifier is int2hex(patternFocus[r+1][ch+1][5]) if (patternFocus[r+1][ch+1][5] >= 1 && patternFocus[r+1][ch+1][5] <= 255) else "--";

# Cell Text
noteText   is Text(noteClassifier            , ch*cellWidth + gridOffset[1] + cellWidth/30             , r*cellHeight + gridOffset[2], 22 *  scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 0 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);
instrText  is Text(instrClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 + cellWidth/15 , r*cellHeight + gridOffset[2], 22 * scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 1 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);
volText    is Text(volClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 2  + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 2 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);
effectText is Text(effectClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 3  + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 3 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);
paramText is Text(paramClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 4 + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "white" if (keyboardRowFocus == r && keyboardChannelFocus == ch && keyboardElementFocus == 4 && gridFocus) else "black") with ch is 0..(numChannels - 1), r is 0..(patternRows[currentPattern] - 1);


cellFocus is Rectangle(keyboardChannelFocus*cellWidth + keyboardElementFocus*cellWidth/5 +  gridOffset[1], gridOffset[2] +  keyboardRowFocus * cellHeight, cellWidth / 5, cellHeight, "#00000000" if (!gridFocus) else "rgb(0, 0, 0)");

gridBase is gridCell with x is 0..(numChannels - 1), y is 0..(patternRows[currentPattern] - 1);

# SCROLLING
scrollView is Rectangle(0, view_PatternEditor_height - view_PatternEditor_height/14, view_PatternEditor_width, view_PatternEditor_height/28, "#625353", "#7f7f7f");

leftHorzScroll is Rectangle(0, view_PatternEditor_height - view_PatternEditor_height/14, view_PatternEditor_height/28, view_PatternEditor_height/28, "#000000");
rightHorzScroll is Rectangle(view_PatternEditor_width - view_PatternEditor_height/28, view_PatternEditor_height - view_PatternEditor_height/14, view_PatternEditor_height/28, view_PatternEditor_height/28, "#000000");

scrollBar is Rectangle(view_PatternEditor_height/28 + 
    (currentElement/5 * cellWidth + currentChannel * cellWidth)/(view_PatternEditor_width) * (view_PatternEditor_width/cellWidth * 5) , view_PatternEditor_height - view_PatternEditor_height/14, view_PatternEditor_width/(numChannels*cellWidth + 40) * (view_PatternEditor_width - 2*view_PatternEditor_height/28), view_PatternEditor_height/28,"#c98585");

horzScroll is [scrollView, scrollBar, leftHorzScroll, rightHorzScroll];

grid is [gridBase, cellFocus, noteText, instrText, volText, effectText, paramText, channelIDTxt, channelRect,  rowNoStrip, rowNos, horzScroll];

# In render order
editorCanvas is [bottomCover, grid, topCover, orderRender, instrListRender, sampleListRender, information, buttons];
}

action initUIevents {
    mouseHoverRow is floor((mouseY - gridOffset[2])/cellHeight);
    mouseHoverChannel is floor((mouseX - gridOffset[1])/cellWidth);

    mouseHoverInstrumentSampleList is floor((mouseY - 2*fontSize + orderOffset[2])/fontSize);

    mouseOverInstrument is (mouseHoverInstrumentSampleList >= 1 && mouseHoverInstrumentSampleList <= 127 && mouseX >= view_PatternEditor_width/2 && mouseX < 3*view_PatternEditor_width/4 && mouseY < view_PatternEditor_height/4);

    mouseOverSample is (mouseHoverInstrumentSampleList >= 1 && mouseHoverInstrumentSampleList <= 127 && mouseX >= 3 * view_PatternEditor_width/4 && mouseX <= view_PatternEditor_width && mouseY < view_PatternEditor_height/4);

    mouseHoverElement is floor((mouseX - gridOffset[1])/(cellWidth / 5)) % 5;

    mouseOverCell is (mouseHoverRow >= 0 && mouseHoverRow <= patternRows[currentPattern + 1] && mouseHoverChannel >= 0 && mouseHoverChannel <= numChannels && mouseY >= view_PatternEditor_height/4);

    cellScroll = false;

    when(mouseDown) {
        if(!mouseButton == "Left down" && mouseOverCell && abs(mouseWheelVelocity) == 0) {
            rowFocus  = mouseHoverRow;
            channelFocus = mouseHoverChannel;
            elementFocus = mouseHoverElement;
            cellScroll = true;

            if(gridFocus) {
                keyboardElementFocus = elementFocus;
                keyboardChannelFocus = channelFocus;
                keyboardRowFocus = rowFocus;
            }

            ${{console.log(root.lookup("elementFocus").value())}}$
        }
    }

    when(mouseWheel) {
        if(!mousePressed || !mouseOverCell && mouseY >= view_PatternEditor_height/4) {
            ${{console.log("Scrolling...")}}$
            if(mouseWheelVelocity > 0) {
                currentRow++;
            } else if (mouseWheelVelocity < 0) {
                currentRow--;
            }
        } else if (mouseOverCell) {
            idx = patternOffset[currentPattern] +  (rowFocus * numChannels + channelFocus) * 5 + 1; # 1-indexed
            cellIdx = patternOffset[currentPattern] + rowFocus * numChannels + channelFocus;
            if(elementFocus == 0) { # note
                temp = patternArray[idx];
                
                if(mouseWheelVelocity < 0 && temp < 119) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setNote(temp, idx - 1 + 0, cellIdx);
                setInstrument(current_instrument, idx - 1 + 1, cellIdx)
            } else if (elementFocus == 1) { # instrument
                temp = patternArray[idx + 1];

                if(mouseWheelVelocity < 0 && temp < 127) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setInstrument(temp, idx - 1 + 1, cellIdx);
            } else if (elementFocus == 2) { # volume
                temp = patternArray[idx + 2];
                
                if(mouseWheelVelocity < 0 && temp < 100) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setVolume(temp, idx - 1 + 2, cellIdx);
            } else if (elementFocus == 3) { # effect
                temp = patternArray[idx + 3];
                
                if(mouseWheelVelocity < 0 && temp < 26) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setEffect(temp, idx - 1 + 3, cellIdx);
            } else if (elementFocus == 4) { # param
                temp = patternArray[idx + 4];
                
                if(mouseWheelVelocity < 0 && temp < 255) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setParam(temp, idx - 1 + 4, cellIdx);
            }
        }
    }

    when(elementDirty) {
        idx = patternOffset[currentPattern] +  (currentRow * numChannels + currentChannel) * 5 + 1; # 1-indexed
        cellIdx = patternOffset[currentPattern] + currentRow * numChannels + currentChannel;
        if(currentElement == 0) { # note
            setNote(elementValue, idx - 1 + 0, cellIdx);

            if(patternArray[idx + 1] == 0) {
                setInstrument(current_instrument, idx - 1 + 1, cellIdx); # also set current instrument
            }
        } else if (currentElement == 1) { # instrument
            temp = patternArray[idx + 1];

            temp = temp * 10 + elementValue;

            if(temp > 128) {
                while(temp > 128) {
                    digits = floor(log(temp)); # base 10 approximates number of digits

                    power_ten = pow(10, digits);

                    temp = temp % power_ten;
                }
            }

            ${{console.log(root.lookup("temp").value())}}$

            setInstrument(temp, idx - 1 + 1, cellIdx);
        } else if (currentElement == 2) { # volume
            temp = patternArray[idx + 2];

            temp = temp * 10 + elementValue;

            if(temp > 100) {
                while(temp > 100) {
                    digits = floor(log(temp)); # base 10 approximates number of digits

                    power_ten = pow(10, digits);

                    temp = temp % power_ten;
                }
            }

            setVolume(temp, idx - 1 + 2, cellIdx);
        } else if (elementFocus == 3) { # effect
            temp = patternArray[idx + 3];
            
            if(mouseWheelVelocity < 0 && temp < 26) {
                temp = temp + 1;
            } else if (mouseWheelVelocity > 0 && temp > 0) {
                temp = temp - 1;  
            }

            setEffect(temp, idx - 1 + 3, cellIdx);
        } else if (elementFocus == 4) { # param
            temp = patternArray[idx + 4];
            
            if(mouseWheelVelocity < 0 && temp < 255) {
                temp = temp + 1;
            } else if (mouseWheelVelocity > 0 && temp > 0) {
                temp = temp - 1;  
            }

            setParam(temp, idx - 1 + 4, cellIdx);
        }
    }

    when(currentPattern) {
        patternFocus = getPattern(currentPattern - 1, numChannels);
    }

    when(patternDirty) {
        if(patternDirty) {
            patternFocus = getPattern(currentPattern - 1, numChannels);
            patternDirty = false;
        }
    }

    when(currentRow) {
        patternFocus = getPattern(currentPattern - 1, numChannels);
    }

    # button states
    when(patternplus_click) {
        if(patternplus_click && currentPattern < 255) {
            currentPattern++;
        }
    }

    when(patternminus_click) {
        if(patternminus_click && currentPattern > 1) {
            currentPattern--;
        }
    }

    when(sampleload_click) {
        if(sampleload_click) {
            createSample("smp");
        }
    }

    when(sampleDirty) {
        if (sampleDirty) {
            do :project > makeui;
            sampleDirty = false;
        }
    }

    when(playbtn_click) {
        if(playbtn_click && is_playing == false) {
            is_playing = true;
        }
    }

    when(stopbtn_click) {
        if(stopbtn_click && is_playing == true) {
            is_playing = false;
        }
    }

    when(tempoplus_click) {
        if(bpm < 255) {
            bpm++;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "bpm", value: root.lookup("bpm").value()
                })
            }}$
        }
    }

    when(tempominus_click) {
        if(bpm > 10) {
            bpm--;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "bpm", value: root.lookup("bpm").value()
                })
            }}$
        }
    }

     when(speedplus_click) {
        if(ticksPerRow < 12) {
            ticksPerRow++;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "speed", value: root.lookup("ticksPerRow").value()
                })
            }}$
        }
    }

    when(speedminus_click) {
        if(bpm > 1) {
            ticksPerRow--;

            ${{
                root.lookup("engine_node").value().port.postMessage({
                    type: "speed", value: root.lookup("ticksPerRow").value()
                })
            }}$
        }
    }

    when(octaveplus_click) {
        if (octave < 7) {
            octave++;
        }
    }

    when(octaveminus_click) {
        if (octave > 0) {
            octave--;
        }
    }

    when(keyboardRowFocus) {
        currentRow is keyboardRowFocus;
    }

    when (keyboardChannelFocus) {
        currentRow is keyboardRowFocus;
        currentChannel is keyboardChannelFocus;
    }

    when (keyboardElementFocus) {

        cellLeft = keyboardChannelFocus * cellWidth + keyboardElementFocus * (cellWidth / 5);

        cellRight = cellLeft + (cellWidth / 5);

        viewportLeft  = scrollHorz;
        viewportRight = scrollHorz + view_PatternEditor_width;


        if (cellRight + 40 > viewportRight) {
            scrollHorz = (cellRight + 40) - view_PatternEditor_width;
        }

        if (cellLeft < 40) {
            scrollHorz = cellLeft - 40;

            if (scrollHorz < 0) {
                scrollHorz = 0;
            }
        }

        currentRow is keyboardRowFocus;
        currentElement is keyboardElementFocus;
    }

    
}
action instruments {
## Define instruments here
# Use Sample() and Synth(), then add to instruments


}

action config {
## Global variables used by JS-Eden to keep track of the state of the engine inside AudioWorklet

bpm = 140;
ticksPerRow = 6;
currentOrder = 0;
currentPattern = 0;
currentRow = 0;
currentChannel = 0;
numChannels = 8;
current_instrument = 1; # used for midi playback, will have zero effect during arrangement playback

is_playing is false;
}

action makepattern {
    size = NUM_PATTERNS * NUM_ROWS * NUM_CHANNELS * 5;
    patternArray = 0 with i is 1..size;
    patternOrder = 0 with i is 1..NUM_ORDERS;
    patternRows = 64 with i is 1..NUM_PATTERNS;

    offset = 0;

    patternOffset = 0 with i is 1..NUM_PATTERNS;
    
    for(i=1;i<NUM_PATTERNS+1;i++) {
        patternOffset[i] = offset;
        offset = patternOffset[i] + patternRows[i];
    }
}

action timing {
    when(bpm) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "bpm",
                value: root.lookup("bpm").value()
            })
        }}$
    }

    when(ticks_per_row) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "rows-per-beat",
                value: root.lookup("ticks_per_row").value()
            })
        }}$
    }
}


action setuplisteners {
${{
    root.lookup("is_playing").addJSObserver("playback_state", (obs, state) => {
        if(state) {
            root.lookup("engine_node").value().port.postMessage({
                type: "playstart",
                order: root.lookup("pattern_order").value()
            })
        } else {
            root.lookup("engine_node").value().port.postMessage({
                type: "playpause"
            })
        }
    })
}}$
}

action start {
    when(wasmReady) {
        do :project > makepattern;
        do :project > makeui;
        do :project > initUIevents;
        do :project > setuplisteners;
        do :project > timing;
    }
}

# NATIVE EVENT LISTENERS

do lib:unexecuted;
if (jseden_project_mode == "restore") do :project > ACTIVE;
if (jseden_project_mode != "safe") do :project > start;
else createView("safemode","ScriptInput");

action ACTIVE {
    views_list = ["myscript"];
    view_myscript_type = "ScriptInput";
    view_myscript_tabs = [":project > config", ":project > instruments"];
    view_myscript_current = 0;
    jseden_project_title = "Klaxon";

    MAX_PATTERNS = 255;
    MAX_CHANNELS = 127;
    MAX_ROWS = 256;

    bpm = 140;
    ticksPerRow = 6;
    currentOrder = 0;
    currentPattern = 1;

    currentRow is 0;
    currentChannel is 0;
    currentElement is 0;

    numChannels = 8;
    numOrders = 1;

    numSamples = 0;

    rowsPerPattern = 64;
    current_instrument = 1;

    patternDirty = false;
    sampleDirty = true;
    gridFocus = false;

    elementDirty = false;
    elementValue = 0;

    wasmReady = false;

    keyboardRowFocus = 0;
    keyboardChannelFocus = 0;
    keyboardElementFocus = 0;

    scrollHorz = 0;

    is_playing is false;
    order = 0 with i is 1..255;
    keys = 0 with i is 0..119;
    semitones = ["C‒", "C#", "D-", "D#", "E‒", "E#", "F‒", "F#", "G‒", "G#", "A-", "A#", "B"]
    octave = 4;

    instrument_list = InstrumentList("instrument_list");
}