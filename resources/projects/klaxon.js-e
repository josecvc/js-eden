action config {
# Global variables used by JS-Eden to keep track of the state of the engine inside AudioWorklet

bpm = 140;
rows_per_beat = 4;
current_order = 0;
curent_row = 0;

is_playing is false;
}


action setuplisteners {
    ${{
        document.getElementById("audio-file").addEventListener("change", async (e) => {
            // TODO: Find a way to get this to activate when someone defines a sample
            e.preventDefault();
            e.stopPropagation();

            const files = event.target.files;
            const file = files[0];
            
            if(!file) return;

            const buf = await file.arrayBuffer();
            const data = await root.lookup("ctx").value().decodeAudioData(buf);

            // send audio data to engine

            let left = data.getChannelData(0);
            let right;

            if (data.numberOfChannels == 2) {
                right = data.getChannelData(1);
            } else if (data.numberOfChannels == 1) {
                right = left;
            } else {
                throw new Error("Maximum 2 channels per sample.");
            }

            //root.lookup("engine_node").value().port.postMessage({
            //    type: "sample",
            //    filename: file.name,
            //    numberOfChannels: data.numberOfChannels,
            //    sampleRate: data.sampleRate,
            //    duration: data.length,
            //    data: [left, right],
            //})

            console.log({
                type: "sample",
                filename: file.name,
                numberOfChannels: data.numberOfChannels,
                sampleRate: data.sampleRate,
                duration: data.length,
                data: [left, right],
            })
        })
    }}$
}



# NATIVE EVENT LISTENERS

do lib:unexecuted;
if (jseden_project_mode == "restore") do :project > ACTIVE;
if (jseden_project_mode != "safe") do :project > start;
else createView("safemode","ScriptInput");

action ACTIVE {
    views_list = ["myscript"];
    view_myscript_type = "ScriptInput";
    view_myscript_tabs = [":project > config",":project > scratchpad"];
    view_myscript_current = 0;
    jseden_project_title = "Klaxon";

    bpm = 140;
    rows_per_beat = 4;
    current_order = 0;
    current_row = 0;
    rows_per_pattern = 64;
    channels = 8;

    is_playing is false;
    pattern_order = Order("pattern_order"); # holds sequencing data

    do :project > ulsample;
    do :project > setuplisteners;
}