"use cs3;"

/**
 * @title Start Your Model
 */

func initAudioContext {
        ${{
            const audio_context = new AudioContext();
            return audio_context;
        }}$;
    }

func initGainNode {
    ${{
        gainNode = root.lookup("ctx").value().createGain();
        gainNode.connect(root.lookup("ctx").value().destination);
        gainNode.gain.value = 1;
        return gainNode;
    }}$;
}

# nodes used to play audio
ctx is initAudioContext();
gain_node is initGainNode();
engine_node is null; # this specifically is for holding the engine

NUM_PATTERNS is 255;
NUM_ROWS is 64;
NUM_CHANNELS is 8;
NUM_ORDERS is 255;

patternArray = null;
patternRows = null;
patternOffset = null;
patternOrder = null;

playbackArray = null;

wasmMemory = null;

proc we_are_ready {
    ready = true;
}

${{   
    root.lookup("ctx").value().audioWorklet.addModule("../../klaxon-engine/js/audio-base.js").then(() => {
        console.log(
            root.lookup("ctx").value().sampleRate
        )
        const node = new AudioWorkletNode(root.lookup("ctx").value(), "mixer-processor", {numberOfOutputs: 1, outputChannelCount: [2]});

        node.connect(root.lookup("gain_node").value());
        
        fetch("../../klaxon-engine/build/dsp.wasm").then((res) => {
            if(res.ok) {
                res.arrayBuffer().then((buffer) => {
                node.port.postMessage({
                    type: "wasm",
                    wasm: buffer,
                    sampleRate: root.lookup("ctx").value().sampleRate,
                    bpm: 140,
                    ticksPerRow: 6,
                    numPatterns: 255,
                    numRows: 64,
                    numChannels: 8
                    })

                node.port.onmessage = (e) => {
                    root.lookup("wasmMemory").assign(
                        e.data.mem, root.scope, Eden.EdenSymbol.defaultAgent
                    );

                    root.lookup("patternArray").assign(
                        new Uint8Array(e.data.mem, e.data.patternPtr, e.data.patternLength), root.scope, Eden.EdenSymbol.defaultAgent
                    );

                    root.lookup("patternRows").assign(
                        new Uint8Array(e.data.mem, e.data.rowPtr, e.data.rowLength), root.scope, Eden.EdenSymbol.defaultAgent
                    );

                    root.lookup("patternOffset").assign(
                        new Uint32Array(e.data.mem, e.data.offsetPtr, e.data.offsetLength), root.scope, Eden.EdenSymbol.defaultAgent
                    );

                    root.lookup("patternOrder").assign(
                        new Uint32Array(e.data.mem, e.data.orderPtr, e.data.orderLength), root.scope, Eden.EdenSymbol.defaultAgent
                    );

                    root.lookup("playbackArray").assign(
                        new Uint32Array(e.data.mem, e.data.playbackPtr, e.data.playbackLength), root.scope, Eden.EdenSymbol.defaultAgent
                    );

                    root.lookup("we_are_ready").trigger();
                }
                }).catch((e) => console.log("Error: Failed to post message to AudioWorkerNode\n" + e));
            } else {
                throw new Error(res.status);
            }
            
        }).catch((e) => {console.log("Error: Failed to retrieve WebAssembly module.\n" + e);})

        node.port.onmessage = (e) => {
            console.log(e.data);
        };

        root.lookup("engine_node").assign(node, root.scope, Eden.EdenSymbol.defaultAgent);
    }).catch((e) => {
        console.log("Error: Audio Processor failed to initialise.\n" + e);
    });
}}$;

${{
    const keysDown = new Set();
    const transpose = 12;
    const multiplier = 1;
    const keyToNote = { // MIDI
    "KeyQ" :   60 + transpose*multiplier, // C 4
    "Digit2" : 61 + transpose*multiplier, // C# 4/Db 4
    "KeyW" :   62 + transpose*multiplier, // D 4
    "Digit3" : 63 + transpose*multiplier, // D# 4/Eb 4
    "KeyE" :   64 + transpose*multiplier, // E 4
    "KeyR" :   65 + transpose*multiplier, // F 4
    "Digit5" : 66 + transpose*multiplier, // F# 4/Gb 4
    "KeyT" :   67 + transpose*multiplier, // G 4
    "Digit6" : 68 + transpose*multiplier, // G# 4/Ab 4
    "KeyY" :   69 + transpose*multiplier, // A 4
    "Digit7" : 70 + transpose*multiplier, // A# 4/Bb 4
    "KeyU" :   71 + transpose*multiplier, // B 4
    "KeyI" :   72 + transpose*multiplier, // C 5
    "Digit9" : 73 + transpose*multiplier, // C# 5/Db 5
    "KeyO" :   74 + transpose*multiplier, // D 5
    "Digit0" : 75 + transpose*multiplier, // D# 5/ Eb 5
    "KeyP" :   76 + transpose*multiplier // E
    }


    addEventListener("keydown", (e) => {    
        const code = e.code;
        if(!keyToNote.hasOwnProperty(code)) return;

        const element = document.activeElement;
        
        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        if(root.lookup("is_playing").value()) return;

        if(!keysDown.has(code)) {
            keysDown.add(code);
            root.lookup("engine_node").value().port.postMessage({
                type: "note_on",
                note: keyToNote[code],
                instrumentId: root.lookup("current_instrument").value()
            })
        }
        
    })

    addEventListener("keyup", (e) => {
        const code = e.code;

        const element = document.activeElement;

        if(element.tagName.toLowerCase() == "textarea" || element.tagName.toLowerCase() == "input" || element.classList.contains("jseden-title")) return;

        if(root.lookup("is_playing").value()) return;
        
        if(keyToNote.hasOwnProperty(code)) {
            keysDown.delete(code);
            root.lookup("engine_node").value().port.postMessage({
                type: "note_off",
                note: keyToNote[code],
                instrumentId: root.lookup("current_instrument").value()
            })
        }
    })
}}$;

${{
Sample = function(obsName) {
    this.obsName = obsName;
    this.duration = 0;
    this.filename = "";
    this.sampleRate = 0;
}
}}$;

${{
Synth = function(obsName) {
    this.obsName = obsName;
}
}}$;

${{
InstrumentList = function(obsName) {
    this.obsName = obsName;
    this.instruments = [];
}
}}$;

# DEFINITIONS
func Synth {
    para obsName
    
    ${{
        return new Synth();
    }}$
}

func InstrumentList {
    para obsName
    ${{
        return new InstrumentList(obsName);
    }}$
}


func addSample {
    ${{
        const picker = document.getElementById("audio-file-input");
        picker.onchange = async (e) => {
             // TODO: Find a way to get this to activate when someone defines a sample
            e.preventDefault();
            e.stopPropagation();
            
            // console.log(e.target.files);
            const files = e.target.files;
            const file = files[0];
            
            if(!file) return;

            const buf = await file.arrayBuffer();
            const data = await root.lookup("ctx").value().decodeAudioData(buf);

            // send audio data to engine

            let left = data.getChannelData(0);
            let right;

            if (data.numberOfChannels == 2) {
                right = data.getChannelData(1);
            } else if (data.numberOfChannels == 1) {
                right = left;
            } else {
                throw new Error("Maximum 2 channels per sample.");
            }

            root.lookup("engine_node").value().port.postMessage({
               type: "sample",
               filename: file.name,
               numberOfChannels: data.numberOfChannels,
               sampleRate: data.sampleRate,
               duration: data.length,
               data: [left, right],
            })
        }

        picker.click();
    }}$
}

func Sample {
    para obsName

    createView("hidden", "HTMLContent");
    view_hidden_title = "Hidden input";
    view_hidden_visibility = "hidden";
    view_hidden_content = "<input type='file' id='audio-file-input' accept='audio/*' title='Upload Sample'>"

    addSample();

    ${{
        let o = obsName ?? null;
        return new Sample(o);
    }}$
}

