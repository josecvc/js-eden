# INSTRUMENT_LIST JS FUNCTIONS
${{
    // TODO: Make this reflect in the engine
    InstrumentList.prototype.addInstrument = function(inst) {
        this.instruments.push(inst);
    }

    InstrumentList.prototype.removeInstrument = function(instId) {
        if(instId < 0 || instId >= this.instruments.length) return;

        this.instruments.splice(instId, 1);
    }

    InstrumentList.prototype.popInstrument = function() {
        if(this.instruments.length == 0) return;

        this.instruments.pop();
    }

    InstrumentList.prototype.getNumInstruments = function() {
        return this.instruments.length;
    }
}}$

## INSTRUMENT JS-EDEN FUNCTIONS
proc addInstrument {
    para inst
    ${{
        let i = inst;

        root.lookup("instrument_list").value().addInstrument(i);
    }}$
}

proc removeInstrument {
    para instId
    ${{
        root.lookup("instrument_list").value().removeInstrument(instId);
    }}$
}

proc popInstrument {
    ${{
        root.lookup("instrument_list").value().popInstrument();
    }}$
}

function getNumInstruments {
    ${{
       return root.lookup("instrument_list").value().getNumInstruments();
    }}$
}

proc createSample {
    para obsName
    smp = Sample(obsName);
    addInstrument(smp);
}

proc createSynth {
    para obsName
    synth = Synth(obsName);
    addInstrument(synth);
}

## MIDI2NOTE

func midi2note {
    para midi;
    ${{
        const midiToKey = {
             0: "C‒",  1: "C#",
             2: "D‒",  3: "D#",
             4: "E‒",  
             5: "F‒",  6: "F#",
             7: "G‒",  8: "G#",
             9: "A‒", 10: "A#",
            11: "B‒"
        }

        const octave = Math.floor(midi / 12) - 1;

        const semitone = midiToKey[midi % 12];

        return semitone + octave.toString();
    }}$
}

func int2hex {
    para num;
    ${{
        return num.toString(16).padStart(2, "0").toUpperCase();
    }}$
}

func int2char {
    para num;
    ${{
        const c = String.fromCodePoint(65 + num - 1);
        return c;
    }}$
}

func getPattern {
    ${{
        let pattern_id = arguments[0];
        let num_channels = arguments[1];
        console.log(`Getting Pattern ${pattern_id}...`);
        const patternStart = root.lookup("patternOffset").value()[pattern_id];
        const rows = root.lookup("patternRows").value()[pattern_id];

        const noteIds = root.lookup("noteArray").value();
        const instrIds = root.lookup("instrArray").value();
        const volumes = root.lookup("volArray").value();
        const effectIds = root.lookup("effectArray").value();
        const params = root.lookup("paramArray").value();

        const pattern = [];

        for(let r = 0; r < rows; r++) {
            const row = []
            for(let ch = 0; ch < num_channels; ch++) {
                let idx = patternStart + r * num_channels + ch;
                const noteId = noteIds[idx];
                const instrId = instrIds[idx];
                const volume = volumes[idx];
                const effectId = effectIds[idx];
                const param = params[idx];

                row.push([
                    noteId,
                    instrId,
                    volume,
                    effectId,
                    param
                ])
            }

            pattern.push(row);
        }
        
        return pattern;
    }}$
}

func setNote {
    para noteId, idx
    ${{root.lookup("noteArray").value()[idx] = noteId;}}$
    patternDirty = true;
}

func setInstrument {
    para instrId, idx
    ${{root.lookup("instrArray").value()[idx] = instrId;}}$
    patternDirty = true;
}

func setVolume {
    para volume, idx
    ${{root.lookup("volArray").value()[idx] = volume;}}$
    patternDirty = true;
}

func setEffect {
    para effectId, idx
    ${{root.lookup("effectArray").value()[idx] = effectId;}}$
    patternDirty = true;
}

func setParam {
    para param, idx
    ${{root.lookup("paramArray").value()[idx] = param;}}$
    patternDirty = true;
}

## ROW/CHANNEL COUNT

action add_channels {
    new_count = numberOfChannels + 1;
    old_count = numberOfChannels;
    # you basically have to reconstruct the array if you want to stay in JS-EDEN
    # cell is noteId, instrumentId, vol, effect
    old_patterns = patterns;
    channels = old_patterns[p][r][c] if c <= new_count else [72, 0, 0, 0, 0] with c is 1..new_count;
    rows = channels with r is 0..63
    patterns = rows with p is 1..MAX_PATTERNS;
}

## ACTIONS

action makeui {
# Set up canvas
createCanvas("PatternEditor", "editorCanvas", "Pattern Editor");
patternFocus = getPattern(currentPattern - 1, numChannels);


mouseWheelEnabled = true;
view_PatternEditor_width = 1193;
view_PatternEditor_height = 843;
view_PatternEditor_x = 295.5;
view_PatternEditor_y = 8.5;

scale = 0.75;
cellWidth is view_PatternEditor_width/6 * scale;
cellHeight is view_PatternEditor_height/24 * scale;

gridOffset is [40, 3* view_PatternEditor_height / 4 - currentRow*cellHeight]

# Timing
tempoText is Text(bpm, 0, 50, 50, "white", "#CBE5D4");

playText is Text("Play", 0, 0, 50, "white", "#CBE5D4");
playRect is Rectangle(0, 0, 100, 55, "gray");

topCover is Rectangle(0, 0, view_PatternEditor_width, view_PatternEditor_height/2, "blue");
bottomCover is Rectangle(0, view_PatternEditor_height/2, view_PatternEditor_width, view_PatternEditor_height/2, "#00000000", "#000000");
channelRect is Rectangle(ch*cellWidth + gridOffset[1], view_PatternEditor_height/2 , cellWidth, view_PatternEditor_height/2, "#00000000", "#000000") with ch is 0..(numChannels - 1);
# rowNoRect is 

playButton is [playRect, playText];

# Current Pattern
patternIDTxt is Text("Pattern: " + (currentPattern - 1), 0, view_PatternEditor_height/2 - 30 * 1.75, 30, "black", "#000000");


# Grid Rendering
channelIDTxt is Text(ch+1, ch * cellWidth + gridOffset[1], view_PatternEditor_height/2 + 5, 30, "black", "bold") with ch is 0..(numChannels - 1);
rowNos is Text(r if r > 9 else "0" + r, 0*cellWidth, r*cellHeight + gridOffset[2], cellHeight, "black") with r is 0..63
gridCell is Rectangle(x*cellWidth + gridOffset[1], y*cellHeight + gridOffset[2], cellWidth, cellHeight, "#c7dbb0" if (y+1 == currentRow) else "gray" if (y % 4 == 0) else "#dfdfdf", "#000000");

# Cell Mutation
noteClassifier is midi2note(patternFocus[r+1][ch+1][1]) if (patternFocus[r+1][ch+1][1] >= 12 && patternFocus[r+1][ch+1][1] <= 119) else "---";
instrClassifier is patternFocus[r+1][ch+1][2] if (patternFocus[r+1][ch+1][2] >= 1 && patternFocus[r+1][ch+1][2] <= 255) else "--";
volClassifier is patternFocus[r+1][ch+1][3] if (patternFocus[r+1][ch+1][3] >= 1 && patternFocus[r+1][ch+1][3] <= 100) else "--";
effectClassifier is int2char(patternFocus[r+1][ch+1][4]) if (patternFocus[r+1][ch+1][4] >= 1 && patternFocus[r+1][ch+1][4] <= 26) else "-";
paramClassifier is int2hex(patternFocus[r+1][ch+1][5]) if (patternFocus[r+1][ch+1][5] >= 1 && patternFocus[r+1][ch+1][5] <= 255) else "--";

# Cell Text
noteText   is Text(noteClassifier            , ch*cellWidth + gridOffset[1] + cellWidth/30             , r*cellHeight + gridOffset[2], 22 *  scale, "black") with ch is 0..(numChannels - 1), r is 0..63;
instrText  is Text(instrClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 + cellWidth/15 , r*cellHeight + gridOffset[2], 22 * scale, "black") with ch is 0..(numChannels - 1), r is 0..63;
volText    is Text(volClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 2  + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "black") with ch is 0..(numChannels - 1), r is 0..63;
effectText is Text(effectClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 3  + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "black") with ch is 0..(numChannels - 1), r is 0..63;
paramText is Text(paramClassifier, ch*cellWidth + gridOffset[1] + cellWidth/5 * 4 + cellWidth/15, r*cellHeight + gridOffset[2], 22 * scale, "black") with ch is 0..(numChannels - 1), r is 0..63;

gridBase is gridCell with x is 0..(numChannels - 1), y is 0..63;

grid is [gridBase, rowNos, noteText, instrText, volText, effectText, paramText, channelIDTxt, channelRect];

# In render order
editorCanvas is [bottomCover, grid, topCover, playButton, patternIDTxt, tempoText];
}

action initUIevents {
    mouseHoverRow is floor((mouseY - gridOffset[2])/cellHeight);
    mouseHoverChannel is floor((mouseX - gridOffset[1])/cellWidth);

    mouseHoverElement is floor((mouseX - gridOffset[1])/(cellWidth / 5)) % 5;

    mouseOverCell is (mouseHoverRow >= 0 && mouseHoverRow <= 63 && mouseHoverChannel >= 0 && mouseHoverChannel <= 3);

    cellScroll = false;


    when(mouseDown) {
        if(mouseButton == "Left down" && mouseOverCell) {
            rowFocus  = mouseHoverRow;
            channelFocus = mouseHoverChannel;
            elementFocus = mouseHoverElement;
            cellScroll = true;
            ${{console.log(root.lookup("elementFocus").value())}}$
            
        }
    }

    when(mouseWheel) {
        if(!mousePressed || !mouseOverCell) {
            ${{console.log("Scrolling...")}}$
            if(mouseWheelVelocity > 0) {
                currentRow++;
            } else if (mouseWheelVelocity < 0) {
                currentRow--;
            }
        } else if (mouseOverCell) {
            idx = patternOffset[currentPattern] +  rowFocus * numChannels + channelFocus + 1; # 1-indexed
            if(elementFocus == 0) { # note
                temp = noteArray[idx];
                
                if(mouseWheelVelocity < 0 && temp < 119) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setNote(temp, idx - 1);
            } else if (elementFocus == 1) { # instrument
                temp = instrArray[idx];

                if(mouseWheelVelocity < 0 && temp < 127) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setInstrument(temp, idx - 1);
            } else if (elementFocus == 2) { # volume
                temp = volArray[idx];
                
                if(mouseWheelVelocity < 0 && temp < 100) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setVolume(temp, idx - 1);
            } else if (elementFocus == 3) { # effect
                temp = effectArray[idx];
                
                if(mouseWheelVelocity < 0 && temp < 26) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setEffect(temp, idx - 1);
            } else if (elementFocus == 4) { # param
                temp = paramArray[idx];
                
                if(mouseWheelVelocity < 0 && temp < 255) {
                    temp = temp + 1;
                } else if (mouseWheelVelocity > 0 && temp > 0) {
                    temp = temp - 1;  
                }

                setParam(temp, idx - 1);
            }
        }
    }

    when(currentPattern) {
        patternFocus = getPattern(currentPattern - 1, numChannels);
    }

    when(patternDirty) {
        if(patternDirty) {
            patternFocus = getPattern(currentPattern - 1, numChannels);
            patternDirty = false;
        }
    }   


    btn is Button("mybutton", "THIS", 0, 0);
    when(mybutton_click) {
        if(mybutton_click) {
            x = 5;
        }
    }
}
action instruments {
## Define instruments here
# Use Sample() and Synth(), then add to instruments


}

action config {
## Global variables used by JS-Eden to keep track of the state of the engine inside AudioWorklet

bpm = 140;
ticksPerRow = 6;
currentOrder = 0;
currentPattern = 0;
currentRow = 0;
numChannels = 8;
current_instrument = 1; # used for midi playback, will have zero effect during arrangement playback

is_playing is false;
}

action timing {
    when(bpm) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "bpm",
                value: root.lookup("bpm").value()
            })
        }}$
    }

    when(ticks_per_row) {
        ${{
            root.lookup("engine_node").value().port.postMessage({
                type: "rows-per-beat",
                value: root.lookup("ticks_per_row").value()
            })
        }}$
    }
}


action setuplisteners {
${{
    root.lookup("is_playing").addJSObserver("playback_state", (obs, state) => {
        if(state) {
            root.lookup("engine_node").value().port.postMessage({
                type: "playstart",
                order: root.lookup("pattern_order").value()
            })
        } else {
            root.lookup("engine_node").value().port.postMessage({
                type: "playpause"
            })
        }
    })
}}$
}

# NATIVE EVENT LISTENERS

do lib:unexecuted;
if (jseden_project_mode == "restore") do :project > ACTIVE;
if (jseden_project_mode != "safe") do :project > start;
else createView("safemode","ScriptInput");

action ACTIVE {
    views_list = ["myscript"];
    view_myscript_type = "ScriptInput";
    view_myscript_tabs = [":project > config", ":project > instruments"];
    view_myscript_current = 0;
    jseden_project_title = "Klaxon";

    MAX_PATTERNS = 255;
    MAX_CHANNELS = 127;
    MAX_ROWS = 256;

    bpm = 140;
    ticksPerRow = 6;
    currentOrder = 0;
    currentPattern = 1;
    currentRow = 0;
    numChannels = 8;
    rowsPerPattern = 64;
    current_instrument = 1;

    patternDirty = false;

    is_playing is false;
    order = 0 with i is 1..255;
    instrument_list = InstrumentList("instrument_list");
    
    do :project > makeui;
    do :project > initUIevents;
    do :project > setuplisteners;
    do :project > timing;
}