# PATTERN JS FUNCTIONS
${{
    const keyToMidi = {
        "C-": 0,  "C#": 1,
        "Db": 1,  "D-": 2, "D#": 3,
        "Eb": 3,  "E-": 4,
        "F-": 5,  "F#": 6,
        "Gb": 6,  "G-": 7, "G#": 8,
        "Ab": 8,  "A-": 9, "A#": 10,
        "Bb": 10, "B-": 11
    }

    Pattern.prototype.outOfBounds = function(rowNo, columnNo) {
        return rowNo < 0 || rowNo > this.numRows || columnNo < 0 || columnNo > this.numColumns;
    }

    Pattern.prototype.changeCell = function(rowNo, channelNo, trigger) {
        this.rows[rowNo][channelNo] = trigger;
    }

    Pattern.prototype.noteToMidi = function(note) {
        //C-5

        if(note == null) {
            return -1
        }

        const semitone = keyToMidi[note.substring(0, 2)]; // C-

        const octave = parseInt(note.at(2));

        return semitone + (octave + 1) * 12;
    }

    Pattern.prototype.flatten = function() { 
        const flattened = []
        for (let r = 0; r < this.numRows; r++) {
            for (let c = 0; c < this.numChannels; c++) {
                // TODO: Convert everything here to one single integer
                flattened.push(
                    (parseInt(this.noteToMidi(this.rows[r][c].noteId)) & 0xFF) |
                    (((parseInt(this.rows[r][c].instrumentId) || -1) & 0xFF) << 8) |
                    (((parseInt(this.rows[r][c].volume) || 0) & 0xFF) << 16) |
                    (((parseInt(this.rows[r][c].effect) || 0) & 0xFF) << 24)
                );
            }
        }

        return flattened;
    }

    Pattern.prototype.clear = function() {
        for(let r = 0; r < this.numRows; r++) {
            this.rows[r] = []
            for (let c = 0; c < this.numChannels; c++) {
                this.rows[r][c] = new Trigger(null, null, null, null, null);
            }
        }  
    }

    Pattern.prototype.getCell = function(rowNo, columnNo) {
        // doesn't exist

        return this.rows[rowNo][columnNo];
    }

    Pattern.prototype.changeVolume = function(vol, rowNo, columnNo) {
        if(!p.outOfBounds)
            p.rows[rowNo][columnNo].volume = vol;
    }

    Pattern.prototype.toString = function() {
        return this.getEdenCode();
    };

    Pattern.prototype.getEdenCode = function () {
        var s = "Pattern(" + Eden.edenCodeForValues(
            this.obsName, this.numRows)+")";
        return s;
    };
}}$;

# ORDER JS FUNCTIONS
${{
    Order.prototype.getPattern = function(patternId) {
        if(patternId < 0 || patternId >= this.patterns.length) return; // out of bounds

        return this.patterns[patternId]; 
    }

    Order.prototype.addPattern = function(pattern) {
        this.patterns.push(pattern);
    }

    Order.prototype.removePattern = function(patternId) {
        // first check if the pattern is referenced in the sequence

        if(patternId < 0 || patternId >= this.patterns.length) return; // out of bounds

        for(let i = 0; i < this.sequence.length; i++) {
            if(this.sequence[i] == patternId) return; // it has been
        }

        this.patterns.splice(patternId, 1); // remove the single pattern

        for(let i = 0; i < this.sequence.length; i++) {
            if(this.sequence[i] > patternId) this.sequence[i]--;
        }
    }

    Order.prototype.removePatternFromSequence = function(patternId) {
        if (!this.sequence.includes(patternId)) return;

        this.sequence.filter(
            (entry) => entry != patternId
        );
    }

    Order.prototype.setSequence = function(seq) {
        if(!Array.isArray(seq)) return;

        for(let i = 0; i < seq.length; i++) {
            const x = Number(seq[i]);
            if(!Number.isInteger(x)) return;
            if(x < 0 || x >= this.patterns.length) return;
        }
        
        this.sequence = seq;
    }

    Order.prototype.addPatternToSequence = function(patternId, pos) {
        if(patternId < 0 || patternId >= this.patterns.length || pos < 0) return; // out of bounds

        this.sequence.splice(pos, 0, patternId);
    }

    Order.prototype.removeEntryFromSequence = function(pos) {
        if(pos < 0 || pos >= this.sequence.length) return; // out of bounds

        this.sequence.splice(pos, 1);
    }

    Order.prototype.compile = function() {
        // call this to send data over to engine
        let data = {};
        const flattened = []
        data.sequence = this.sequence;
        data.numPatterns = this.patterns.length;

        for(let i = 0; i < this.patterns.length; i++) {
            flattened.push(this.patterns[i].flatten())
        }

        data.patterns = flattened.flat();

        return data;
    }

    Order.prototype.toString = function() {
        return this.getEdenCode();
    }

    Order.prototype.getEdenCode = function () {
        var s = "Order(" + Eden.edenCodeForValues(
            this.obsName)+")";
        return s;
    }
}}$

