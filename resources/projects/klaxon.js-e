"use cs3;"

/**
 * @title Start Your Model
 */

func initAudioContext {
        ${{
            const audio_context = new AudioContext();
            return audio_context;
        }}$;
    }

func initGainNode {
    ${{
        gainNode = root.lookup("ctx").value().createGain();
        gainNode.connect(root.lookup("ctx").value().destination);
        gainNode.gain.value = 1;
        return gainNode;
    }}$;
}

# nodes used to play audio
ctx is initAudioContext();
gain_node is initGainNode();
engine_node is null; # this specifically is for holding the engine

${{
    root.lookup("ctx").value().audioWorklet.addModule("../../klaxon-engine/js/audio-base.js").then(() => {
        console.log(
            root.lookup("ctx").value().sampleRate
        )
        const node = new AudioWorkletNode(root.lookup("ctx").value(), "mixer-processor", {numberOfInputs: 16, numberOfOutputs: 1, outputChannelCount: [2]});

        node.connect(root.lookup("gain_node").value());
        
        fetch("../../klaxon-engine/build/dsp.wasm").then((res) => {
            if(res.ok) {
                res.arrayBuffer().then((buffer) => {
                node.port.postMessage({
                    type: "wasm",
                    wasm: buffer,
                    sampleRate: root.lookup("ctx").value().sampleRate,
                    bpm: 140,
                    rowsPerBeat: 4
                    })
                }).catch((e) => console.log("Error: Failed to post message to AudioWorkerNode\n" + e));
            } else {
                throw new Error(res.status);
            }
            
        }).catch((e) => {console.log("Error: Failed to retrieve WebAssembly module.\n" + e);})

        node.port.onmessage = (e) => {
            console.log(e.data);
        };

        root.lookup("engine_node").assign(node, root.scope, Eden.EdenSymbol.defaultAgent);

        fetch("../../klaxon-engine/assets/Cumulus Break.wav").then(async (res) => {
            const url = res.url;
            const filename = decodeURIComponent(url.split("/").pop());
            const buf = await res.arrayBuffer();

            return {filename: filename, buffer: buf};
        }).then(async (payload) => {
            const buf = await root.lookup("ctx").value().decodeAudioData(payload.buffer);
            return {filename: payload.filename, data: buf};
        }).then((decoded) => {
            const data = decoded.data;

            let left = data.getChannelData(0);
            let right;

            if (data.numberOfChannels == 2) {
                right = data.getChannelData(1);
            } else if (data.numberOfChannels == 1) {
                right = left;
            } else {
                throw new Error("Maximum 2 channels per sample.");
            }

            root.lookup("engine_node").value().port.postMessage({
                type: "sample",
                filename: decoded.filename,
                numberOfChannels: data.numberOfChannels,
                sampleRate: data.sampleRate,
                duration: data.length,
                data: [left, right],
            })
        })

    }).catch((e) => {
        console.log("Error: Audio Processor failed to initialise.\n" + e);
    });
}}$;

${{
    const keysDown = new Set();
    const transpose = 12;
    const multiplier = -2;
    const keyToNote = { // just to sample
    "KeyQ" :   40 + transpose*multiplier, // C 4
    "Digit2" : 41 + transpose*multiplier, // C# 4/Db 4
    "KeyW" :   42 + transpose*multiplier, // D 4
    "Digit3" : 43 + transpose*multiplier, // D# 4/Eb 4
    "KeyE" :   44 + transpose*multiplier, // E 4
    "KeyR" :   45 + transpose*multiplier, // F 4
    "Digit5" : 46 + transpose*multiplier, // F# 4/Gb 4
    "KeyT" :   47 + transpose*multiplier, // G 4
    "Digit6" : 48 + transpose*multiplier, // G# 4/Ab 4
    "KeyY" :   49 + transpose*multiplier, // A 4
    "Digit7" : 50 + transpose*multiplier, // A# 4/Bb 4
    "KeyU" :   51 + transpose*multiplier, // B 4
    "KeyI" :   52 + transpose*multiplier, // C 5
    "Digit9" : 53 + transpose*multiplier, // C# 5/Db 5
    "KeyO" :   54 + transpose*multiplier, // D 5
    "Digit0" : 55 + transpose*multiplier, // D# 5/ Eb 5
    "KeyP" :   56 + transpose*multiplier // E
    }


    addEventListener("keydown", (e) => {    
        const code = e.code;
        if(!keyToNote.hasOwnProperty(code)) return;

        if(!keysDown.has(code)) {
            keysDown.add(code);
            root.lookup("engine_node").value().port.postMessage({
                type: "note_on",
                note: keyToNote[code],
                instrumentId: 0
            })
        }
        
    })

    addEventListener("keyup", (e) => {
        const code = e.code;
        if(keyToNote.hasOwnProperty(code)) {
            keysDown.delete(code);
            root.lookup("engine_node").value().port.postMessage({
                type: "note_off",
                note: keyToNote[code],
                instrumentId: 0
            })
        }
    })
}}$;


${{
Trigger = function(obsName, noteId, instrumentId, volume, effect) {
    this.obsName = obsName
    this.noteId = noteId ?? null;
    this.instrumentId = instrumentId ?? null;
    this.volume = volume ?? null;
    this.effect = effect ?? null;
}
}}$

${{
Pattern = function(obsName) {
    this.obsName = obsName
    this.numRows = 64;
    this.numChannels = 8;
    this.rows = [];
    this.clear();
}
}}$;

func Pattern {
    para observableName;
    ${{
        return new Pattern(arguments[0]);
    }}$;
}

func Trigger {
    para obsName, noteId, instrumentId, volume, effect
    ${{
        let o = obsName ?? null;
        let n = noteId ?? null;
        let i = instrumentId ?? null;
        let v = volume ?? null;
        let e = effect ?? null;

        return new Trigger(o, n, i, v, e);
    }}$
}

${{
Pattern.prototype.outOfBounds = function(rowNo, columnNo) {
    return rowNo < 0 || rowNo > this.numRows || columnNo < 0 || columnNo > this.numColumns;
}

Pattern.prototype.changeCell = function(rowNo, channelNo, trigger) {
    this.rows[rowNo][channelNo] = trigger;
}

Pattern.prototype.flatten = function() {
    const flattened = []
    for (let r = 0; r < this.numRows; r++) {
        for (let c = 0; c < this.numChannels; c++) {
            flattened.push(
                this.rows[r][c].noteId,
                this.rows[r][c].instrumentId,
                this.rows[r][c].volume,
                this.rows[r][c].effect,
            );
        }
    }

    return flattened;
}

Pattern.prototype.clear = function() {
    for(let r = 0; r < this.numRows; r++) {
        this.rows[r] = []
        for (let c = 0; c < this.numChannels; c++) {
            this.rows[r][c] = new Trigger(null, null, null, null, null);
        }
    }  
}

Pattern.prototype.getCell = function(rowNo, columnNo) {
     // doesn't exist

    return this.rows[rowNo][columnNo];
}

Pattern.prototype.toString = function() {
	return this.getEdenCode();
};

Pattern.prototype.getEdenCode = function () {
	var s = "Pattern(" + Eden.edenCodeForValues(
        this.obsName, this.numRows)+")";
	return s;
};

Pattern.prototype.changeVolume = function(vol, rowNo, columnNo) {
    if(!p.outOfBounds)
        p.rows[rowNo][columnNo].volume = vol;
}
}}$;

proc changeCell {
    para pattern, trigger, rowNo, columnNo
    ${{
        const p = arguments[0];
        const t = arguments[1];

        const r = arguments[2];
        const c = arguments[3];

        p.changeCell(r, c, t);

        root.lookup(p.obsName).assign(p, root.scope, Eden.EdenSymbol.defaultAgent);
    }}$
}

func getCell {
    para pattern, rowNo, columnNo
    ${{
        const p = arguments[0];
        const r = arguments[1];
        const c = arguments[2];

        return p.getCell(r, c);
    }}$
}

proc setVolume {
    para pattern, vol, rowNo, columnNo
    ${{
        const p = arguments[0];
        const v = arguments[1];
        const r = arguments[2];
        const c = arguments[3];

        if (!p.outOfBounds(r, c))
            p.setVolume(vol, rowNo, columnNo);
        
        root.lookup(p.obsName).assign(p, root.scope, Eden.EdenSymbol.defaultAgent);
    }}$
}

${{
    root.lookup("is_playing").addJSObserver("playback_state", (obs, state) => {
        if(state) {
            root.lookup("engine_node").value().port.postMessage({
                type: "playback",
                value: state,
                order: root.lookup("order").value()
            })
        }
    })
}}$

action scratchpad {
    # make your patterns here
}

action config {
# global variables used by js-eden to know 
# the current position of playback in the audio engine

bpm = 140;
rows_per_beat = 4;
current_pattern = 0;
curent_row = 0;

is_playing is false;
}

do lib:unexecuted;
if (jseden_project_mode == "restore") do :project > ACTIVE;
if (jseden_project_mode != "safe") do :project > start;
else createView("safemode","ScriptInput");

action ACTIVE {
    views_list = ["myscript"];
    view_myscript_type = "ScriptInput";
    view_myscript_tabs = [":project > config",":project > scratchpad"];
    view_myscript_current = 0;
    jseden_project_title = "Klaxon";

    bpm = 140;
    rows_per_beat = 4;
    current_pattern = 0;
    current_row = 0;
    rows_per_pattern = 64;
    channels = 8;

    is_playing is false;
}
